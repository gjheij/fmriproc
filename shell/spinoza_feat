#!/usr/bin/env bash
set -euo pipefail

# Optional site setup, matching the Spinoza wrappers when available.
if [[ -n "${SETUP_FILE:-}" && -f "${SETUP_FILE}" ]]; then
  # shellcheck disable=SC1090
  source "${SETUP_FILE}"
fi
if command -v call_bashhelper >/dev/null 2>&1; then
  # shellcheck disable=SC1091
  source call_bashhelper
fi

err() {
  if declare -F print_error_msg >/dev/null 2>&1; then
    print_error_msg "$(basename "$0")" "input" "$*"
  else
    printf 'ERROR: %s\n' "$*" >&2
  fi
}

print_command() {
  if declare -F print_cmd >/dev/null 2>&1; then
    print_cmd "$@"
  else
    printf '%q ' "$@"
    printf '\n'
  fi
}

Usage() {
  cat <<USAGE
---------------------------------------------------------------------------------------------------
spinoza_feat

SLURM-array/local queue wrapper for FEAT analyses using call_feat, call_feat2, and call_feat3.
The wrapper limits the number of simultaneously running jobs; native call_feat* options are passed
through unchanged after '--'.

Usage:
  spinoza_feat [wrapper options] <project root> -- [call_feat* options]

Wrapper options:
  -l, --level <1|2|3>   FEAT level / command: 1=call_feat, 2=call_feat2, 3=call_feat3. Default = 1
  -s, --subject <ids>    subjects to queue, comma/space separated (levels 1/2).
                         Native --subject after '--' is also supported and used for queue splitting.
  -m, --max-running <N>  maximum jobs running simultaneously. Default = 6
  -j, --cpus <N>         CPUs requested per SLURM job. Default = 1
  -q, --queue <name>     SLURM partition. Default = \$SGE_QUEUE_LONG, or 'main'
      --local             run through a local process queue instead of SLURM
      --dry-run           print generated jobs/commands without running/submitting
      --job-name <name>   SLURM job name. Default = featL<level>
  -h, --help              show this help

Automatic defaults (only added when the corresponding native option is absent):
  level 1: --bids-dir   <project root>
           --deriv-dir  <project root>/derivatives/feat/level1
  level 2: --manifest   <project root>/derivatives/feat/level1/contrast_manifest.tsv
           --output-dir <project root>/derivatives/feat/level2
  level 3: --manifest   level2/contrast_manifest_level2.tsv if it exists, otherwise level1 manifest
           --output-dir <project root>/derivatives/feat/level3

Queue unit:
  level 1: one call_feat job per subject, throttled by --max-running
  level 2: one call_feat2 job per eligible subject/session/task/canonical-contrast group,
           throttled by --max-running. Each task writes a private manifest fragment; fragments
           are merged into contrast_manifest_level2.tsv after all jobs complete.
  level 3: one call_feat3 job for the requested group analysis

---------------------------------------------------------------------------------------------------
Examples:
  spinoza_feat -l 1 -m 6 -j 2 /data/study -- \\
    --task faces --space T1w

  spinoza_feat -l 1 -s 01,02,03 -m 2 /data/study -- \\
    --task faces --contrast 'Face>House;T;Face,House;1,-1' --overwrite

  spinoza_feat -l 2 -m 4 /data/study -- \\
    --min-runs 2 --overwrite

  spinoza_feat -l 3 -m 3 /data/study -- \\
    --runmode flame1 --min-subjects 10

Any call_feat/call_feat2/call_feat3 option not listed here is still supported: put it after '--'.

---------------------------------------------------------------------------------------------------
Call with master:

  # Level 1 FEAT: first-level subject-wise analysis
  master -m $(get_module_nr $(basename ${0})) \\
    -l 1 \\
    -s 01,02,03 \\
    -j 2 \\
    -x "--task faces --space T1w"

  # Level 1 FEAT with contrast and SLURM submission
  master -m $(get_module_nr $(basename ${0})) \\
    -l 1 \\
    -s 01,02,03 \\
    -j 2 \\
    --sge \\
    -x "--task faces --contrast 'Face>House;T;Face,House;1,-1' --overwrite"

  # Level 2 FEAT: subject/contrast aggregation
  master -m $(get_module_nr $(basename ${0})) \\
    -l 2 \\
    -j 4 \\
    --sge \\
    -x "--min-runs 2 --overwrite"

  # Level 3 FEAT: group analysis
  master -m $(get_module_nr $(basename ${0})) \\
    -l 3 \\
    -j 3 \\
    --sge \\
    -x "--runmode flame1"

---------------------------------------------------------------------------------------------------
USAGE
}

level=1
subjects_cli=""
max_running=6
n_cpus=1
queue="${SGE_QUEUE_LONG:-main}"
run_local=0
dry_run=0
job_name=""
proj_dir=""
pass_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -l|--level)
      [[ $# -ge 2 ]] || { err "$1 requires a value"; exit 2; }
      level="$2"; shift 2 ;;
    -s|--subject)
      [[ $# -ge 2 ]] || { err "$1 requires a value"; exit 2; }
      subjects_cli="${subjects_cli}${subjects_cli:+,}$2"; shift 2 ;;
    -m|--max-running)
      [[ $# -ge 2 ]] || { err "$1 requires a value"; exit 2; }
      max_running="$2"; shift 2 ;;
    -j|--cpus|--cpus-per-job)
      [[ $# -ge 2 ]] || { err "$1 requires a value"; exit 2; }
      n_cpus="$2"; shift 2 ;;
    -q|--queue|--partition)
      [[ $# -ge 2 ]] || { err "$1 requires a value"; exit 2; }
      queue="$2"; shift 2 ;;
    --job-name)
      [[ $# -ge 2 ]] || { err "$1 requires a value"; exit 2; }
      job_name="$2"; shift 2 ;;
    --local)
      run_local=1; shift ;;
    --dry-run)
      dry_run=1; shift ;;
    -h|--help)
      Usage; exit 0 ;;
    --)
      shift
      pass_args=("$@")
      break ;;
    -*)
      err "Unknown wrapper option: $1 (native call_feat* options must go after '--')"
      Usage
      exit 2 ;;
    *)
      if [[ -n "$proj_dir" ]]; then
        err "Only one project root may be specified before '--'"
        exit 2
      fi
      proj_dir="$1"; shift ;;
  esac
done

[[ "$level" =~ ^[123]$ ]] || { err "--level must be 1, 2, or 3"; exit 2; }
[[ "$max_running" =~ ^[1-9][0-9]*$ ]] || { err "--max-running must be a positive integer"; exit 2; }
[[ "$n_cpus" =~ ^[1-9][0-9]*$ ]] || { err "--cpus must be a positive integer"; exit 2; }
[[ -n "$proj_dir" ]] || { err "Project root not specified"; Usage; exit 2; }

# realpath -m also works for paths that do not yet exist (useful for dry-runs).
if realpath -m / >/dev/null 2>&1; then
  proj_dir="$(realpath -m "$proj_dir")"
else
  proj_dir="$(cd "$proj_dir" && pwd -P)"
fi

work_dir="${proj_dir}/code/logs"
mkdir -p "$work_dir"
job_name="${job_name:-featL${level}}"

# Return success when an option exists in pass_args, supporting --opt value and --opt=value.
has_opt() {
  local wanted="$1" a
  for a in "${pass_args[@]}"; do
    [[ "$a" == "$wanted" || "$a" == "$wanted="* ]] && return 0
  done
  return 1
}

# Get the last value of a single-valued option from pass_args.
get_opt_value() {
  local wanted="$1" i a value=""
  for ((i=0; i<${#pass_args[@]}; i++)); do
    a="${pass_args[$i]}"
    if [[ "$a" == "$wanted" ]]; then
      (( i + 1 < ${#pass_args[@]} )) || { err "$wanted requires a value"; exit 2; }
      value="${pass_args[$((i+1))]}"
    elif [[ "$a" == "$wanted="* ]]; then
      value="${a#*=}"
    fi
  done
  printf '%s' "$value"
}

# Pull a repeatable selector out of pass_args so each queued command gets exactly one split value.
# Values may themselves be comma-separated. Remaining args are stored back in pass_args.
extract_repeatable_opt() {
  local wanted="$1" i a v
  local -a kept=()
  EXTRACTED=()
  for ((i=0; i<${#pass_args[@]}; i++)); do
    a="${pass_args[$i]}"
    if [[ "$a" == "$wanted" ]]; then
      (( i + 1 < ${#pass_args[@]} )) || { err "$wanted requires a value"; exit 2; }
      v="${pass_args[$((i+1))]}"
      IFS=',' read -r -a _vals <<< "$v"
      EXTRACTED+=("${_vals[@]}")
      i=$((i+1))
    elif [[ "$a" == "$wanted="* ]]; then
      v="${a#*=}"
      IFS=',' read -r -a _vals <<< "$v"
      EXTRACTED+=("${_vals[@]}")
    else
      kept+=("$a")
    fi
  done
  pass_args=("${kept[@]}")
}


join_by_comma() {
  local IFS=,
  printf '%s' "$*"
}

# Build the level-2 queue from the first-level manifest after applying the same
# selectors that each call_feat2 task will receive. Output columns are:
#   subject<TAB>session<TAB>task<TAB>canonical_name
build_level2_jobs() {
  local manifest="$1"
  local jobs_out="$2"
  local subjects_csv="$3"
  local sessions_csv="$4"
  local tasks_csv="$5"
  local contrasts_csv="$6"
  local runs_csv="$7"
  local min_runs="$8"

  python3 - "$manifest" "$jobs_out" \
    "$subjects_csv" "$sessions_csv" "$tasks_csv" "$contrasts_csv" "$runs_csv" "$min_runs" <<'PY'
import csv
import sys
from collections import defaultdict

manifest_path, jobs_path, subjects_s, sessions_s, tasks_s, contrasts_s, runs_s, min_runs_s = sys.argv[1:]

def selector(value, prefix=None):
    values = set()
    for item in value.split(","):
        if not item:
            continue
        if prefix and item.startswith(prefix):
            item = item[len(prefix):]
        values.add(item)
    return values

subjects = selector(subjects_s, "sub-")
sessions = selector(sessions_s, "ses-")
tasks = selector(tasks_s, "task-")
contrasts = selector(contrasts_s)
runs = selector(runs_s, "run-")
min_runs = int(min_runs_s)

groups = defaultdict(set)

with open(manifest_path, newline="", encoding="utf-8") as f:
    reader = csv.DictReader(f, delimiter="\t")
    required = {"subject", "session", "task", "run", "run_label", "canonical_name"}
    missing = required - set(reader.fieldnames or [])
    if missing:
        raise SystemExit("Manifest is missing columns: " + ", ".join(sorted(missing)))

    for row in reader:
        subject = row.get("subject", "")
        session = row.get("session", "")
        task = row.get("task", "")
        run = row.get("run", "")
        canonical = row.get("canonical_name", "")

        if subjects and subject not in subjects:
            continue
        if sessions and session not in sessions:
            continue
        if tasks and task not in tasks:
            continue
        if contrasts and canonical not in contrasts:
            continue
        if runs and run not in runs:
            continue

        key = (subject, session, task, canonical)
        groups[key].add(row.get("run_label", "") or run)

eligible = [
    key for key, unique_runs in groups.items()
    if len(unique_runs) >= min_runs
]

eligible.sort(key=lambda x: (x[0], x[1], x[2], x[3]))

with open(jobs_path, "w", encoding="utf-8", newline="") as f:
    writer = csv.writer(f, delimiter="\t", lineterminator="\n")
    writer.writerows(eligible)
PY
}

normalize_subjects() {
  local raw="$1" s
  local -a vals=()
  raw="${raw// /,}"
  IFS=',' read -r -a vals <<< "$raw"
  for s in "${vals[@]}"; do
    [[ -n "$s" ]] || continue
    s="${s#sub-}"
    printf '%s\n' "$s"
  done
}

#-----------------------------------------------------------------------------
# intro
start_timer "GLM analysis with FSL's FEAT"

command_name="call_feat${level#1}"
[[ "$level" == 1 ]] && command_name="call_feat"

# Add standard project paths only when the native option was not supplied.
case "$level" in
  1)
    if ! has_opt --bids-dir; then pass_args=(--bids-dir "$proj_dir" "${pass_args[@]}"); fi
    if ! has_opt --deriv-dir; then pass_args=(--deriv-dir "$proj_dir/derivatives/feat/level1" "${pass_args[@]}"); fi
    ;;
  2)
    if ! has_opt --manifest; then pass_args=(--manifest "$proj_dir/derivatives/feat/level1/contrast_manifest.tsv" "${pass_args[@]}"); fi
    if ! has_opt --output-dir; then pass_args=(--output-dir "$proj_dir/derivatives/feat/level2" "${pass_args[@]}"); fi
    ;;
  3)
    if ! has_opt --manifest; then
      level2_manifest="$proj_dir/derivatives/feat/level2/contrast_manifest_level2.tsv"
      level1_manifest="$proj_dir/derivatives/feat/level1/contrast_manifest.tsv"
      if [[ -f "$level2_manifest" ]]; then
        pass_args=(--manifest "$level2_manifest" "${pass_args[@]}")
      else
        pass_args=(--manifest "$level1_manifest" "${pass_args[@]}")
      fi
    fi
    if ! has_opt --output-dir; then pass_args=(--output-dir "$proj_dir/derivatives/feat/level3" "${pass_args[@]}"); fi
    ;;
esac

# Native call_feat2 --dry-run produces no FEAT outputs and therefore no
# per-array manifest fragments. Track this separately from the wrapper-level
# spinoza_feat --dry-run flag so we do not attempt to merge nonexistent files.
level2_write_manifest=1
if [[ "$level" == 2 ]] && has_opt --dry-run; then
  level2_write_manifest=0
fi

jobs_file="${work_dir}/spinoza_feat_L${level}_jobs.txt"
: > "$jobs_file"

if [[ "$level" == 1 ]]; then
  extract_repeatable_opt --subject
  native_subjects=("${EXTRACTED[@]}")

  if [[ -n "$subjects_cli" && ${#native_subjects[@]} -gt 0 ]]; then
    err "Specify subjects either with wrapper -s/--subject or native --subject after '--', not both"
    exit 2
  fi

  if [[ -n "$subjects_cli" ]]; then
    normalize_subjects "$subjects_cli" | awk 'NF && !seen[$0]++' > "$jobs_file"
  elif [[ ${#native_subjects[@]} -gt 0 ]]; then
    printf '%s\n' "${native_subjects[@]}" | sed 's/^sub-//' | awk 'NF && !seen[$0]++' > "$jobs_file"
  else
    bids_dir="$(get_opt_value --bids-dir)"
    if [[ ! -d "$bids_dir" ]]; then
      err "Cannot discover subjects: BIDS directory does not exist: $bids_dir"
      exit 1
    fi
    find "$bids_dir" -maxdepth 1 -mindepth 1 \( -type d -o -type l \) -name 'sub-*' -printf '%f\n' 2>/dev/null \
      | sed 's/^sub-//' | sort -V > "$jobs_file"
  fi

elif [[ "$level" == 2 ]]; then
  # Pull group-defining selectors out of pass_args. They are used once to
  # discover the queue and then re-added per array task as exact selectors.
  extract_repeatable_opt --subject
  native_subjects=("${EXTRACTED[@]}")

  if [[ -n "$subjects_cli" && ${#native_subjects[@]} -gt 0 ]]; then
    err "Specify subjects either with wrapper -s/--subject or native --subject after '--', not both"
    exit 2
  fi

  if [[ -n "$subjects_cli" ]]; then
    mapfile -t level2_subjects < <(normalize_subjects "$subjects_cli" | awk 'NF && !seen[$0]++')
  else
    level2_subjects=("${native_subjects[@]}")
  fi

  extract_repeatable_opt --session
  level2_sessions=("${EXTRACTED[@]}")

  extract_repeatable_opt --task
  level2_tasks=("${EXTRACTED[@]}")

  extract_repeatable_opt --contrast
  level2_contrasts=("${EXTRACTED[@]}")

  # --run remains a normal call_feat2 selector, but we also need its values
  # when determining whether a group satisfies --min-runs.
  level2_runs=()
  for ((i=0; i<${#pass_args[@]}; i++)); do
    if [[ "${pass_args[$i]}" == "--run" ]]; then
      (( i + 1 < ${#pass_args[@]} )) || { err "--run requires a value"; exit 2; }
      IFS=',' read -r -a _vals <<< "${pass_args[$((i+1))]}"
      level2_runs+=("${_vals[@]}")
      i=$((i+1))
    elif [[ "${pass_args[$i]}" == --run=* ]]; then
      IFS=',' read -r -a _vals <<< "${pass_args[$i]#*=}"
      level2_runs+=("${_vals[@]}")
    fi
  done

  manifest_path="$(get_opt_value --manifest)"
  [[ -f "$manifest_path" ]] || {
    err "Level-1 manifest does not exist: $manifest_path"
    exit 1
  }

  min_runs="$(get_opt_value --min-runs)"
  [[ -n "$min_runs" ]] || min_runs=2
  [[ "$min_runs" =~ ^[1-9][0-9]*$ ]] || {
    err "--min-runs must be a positive integer"
    exit 2
  }

  build_level2_jobs \
    "$manifest_path" \
    "$jobs_file" \
    "$(join_by_comma "${level2_subjects[@]}")" \
    "$(join_by_comma "${level2_sessions[@]}")" \
    "$(join_by_comma "${level2_tasks[@]}")" \
    "$(join_by_comma "${level2_contrasts[@]}")" \
    "$(join_by_comma "${level2_runs[@]}")" \
    "$min_runs"

  # Each array task gets a private manifest fragment. A dependent merge job
  # combines these only after all fixed-effects jobs finish successfully.
  manifest_parts_dir="$(mktemp -d "${work_dir}/spinoza_feat_L2_manifest_parts.XXXXXX")"
  output_dir="$(get_opt_value --output-dir)"
  level2_manifest="${output_dir}/contrast_manifest_level2.tsv"
  merge_runner="${work_dir}/spinoza_feat_L2_merge_manifest.sh"

else
  [[ -z "$subjects_cli" ]] || {
    err "Wrapper -s/--subject is only valid for levels 1 and 2; for level 3 put native --subject after '--'"
    exit 2
  }
  printf 'all\n' > "$jobs_file"
fi

n_jobs="$(awk 'NF{n++} END{print n+0}' "$jobs_file")"
if [[ "$n_jobs" -eq 0 ]]; then
  err "No jobs found for level $level"
  exit 1
fi

runner="${work_dir}/spinoza_feat_L${level}_runner.sh"
{
  cat <<EOF
#!/usr/bin/env bash
set -euo pipefail
if [[ -n "\${SETUP_FILE:-}" && -f "\${SETUP_FILE}" ]]; then
  source "\${SETUP_FILE}"
fi
if command -v call_bashhelper >/dev/null 2>&1; then
  source call_bashhelper
fi

job_value=\$(sed -n "\${SLURM_ARRAY_TASK_ID}p" $(printf '%q' "$jobs_file"))
if [[ -z "\${job_value}" ]]; then
  echo "ERROR: no queue value for SLURM_ARRAY_TASK_ID=\${SLURM_ARRAY_TASK_ID}" >&2
  exit 1
fi

cmd=( $(printf '%q' "$command_name") )
EOF

  for arg in "${pass_args[@]}"; do
    printf 'cmd+=(%q)\n' "$arg"
  done

  if [[ "$level" == 1 ]]; then
    cat <<'EOF'
cmd+=(--subject "${job_value}")
EOF
  elif [[ "$level" == 2 ]]; then
    cat <<EOF
IFS=\$'\\t' read -r job_subject job_session job_task job_contrast <<< "\${job_value}"

cmd+=(--subject "\${job_subject}")
[[ -z "\${job_session}" ]] || cmd+=(--session "\${job_session}")
[[ -z "\${job_task}" ]] || cmd+=(--task "\${job_task}")
cmd+=(--contrast "\${job_contrast}")
cmd+=(--manifest-out "$(printf '%q' "${manifest_parts_dir}")/job-\${SLURM_ARRAY_TASK_ID}.tsv")
EOF
  fi

  cat <<'EOF'
if declare -F print_cmd >/dev/null 2>&1; then
  print_cmd "${cmd[@]}"
else
  printf '%q ' "${cmd[@]}"; printf '\n'
fi
"${cmd[@]}"
EOF
} > "$runner"

array_spec="1-${n_jobs}%${max_running}"


if [[ "$level" == 2 ]]; then
  cat > "$merge_runner" <<EOF
#!/usr/bin/env bash
set -euo pipefail

python3 - $(printf '%q' "$manifest_parts_dir") $(printf '%q' "$level2_manifest") <<'PY'
import csv
import sys
from pathlib import Path

parts_dir = Path(sys.argv[1])
out_file = Path(sys.argv[2])
parts = sorted(parts_dir.glob("job-*.tsv"))

if not parts:
    raise SystemExit(f"No level-2 manifest fragments found in {parts_dir}")

rows = []
fieldnames = None

for part in parts:
    with part.open(newline="", encoding="utf-8") as f:
        reader = csv.DictReader(f, delimiter="\t")
        if fieldnames is None:
            fieldnames = reader.fieldnames
        elif reader.fieldnames != fieldnames:
            raise SystemExit(f"Manifest columns differ in {part}")
        rows.extend(reader)

if not fieldnames:
    raise SystemExit("Level-2 manifest fragments contain no header")

# Deduplicate deterministically. Normally every array task contributes one row.
seen = set()
unique = []
key_fields = [x for x in ("subject", "session", "task", "canonical_name", "cope_file", "varcope_file") if x in fieldnames]
for row in rows:
    key = tuple(row.get(k, "") for k in key_fields)
    if key in seen:
        continue
    seen.add(key)
    unique.append(row)

sort_fields = [x for x in ("subject", "session", "task", "canonical_name") if x in fieldnames]
unique.sort(key=lambda row: tuple(row.get(k, "") for k in sort_fields))

out_file.parent.mkdir(parents=True, exist_ok=True)
tmp = out_file.with_name(out_file.name + ".tmp")
with tmp.open("w", newline="", encoding="utf-8") as f:
    writer = csv.DictWriter(f, fieldnames=fieldnames, delimiter="\t", lineterminator="\n")
    writer.writeheader()
    writer.writerows(unique)
tmp.replace(out_file)

print(f"Merged {len(parts)} fragment(s), {len(unique)} row(s) -> {out_file}")
PY
EOF
fi

print_summary() {
  printf 'FEAT level:       %s (%s)\n' "$level" "$command_name"
  printf 'Jobs:             %s\n' "$n_jobs"
  printf 'Max simultaneous: %s\n' "$max_running"
  printf 'CPUs/job:         %s\n' "$n_cpus"
  printf 'Queue:            %s\n' "$queue"
  printf 'Jobs file:        %s\n' "$jobs_file"
  printf 'Runner:           %s\n' "$runner"
}

if [[ "$dry_run" -eq 1 ]]; then
  print_summary
  printf '\nQueue values:\n'
  nl -ba "$jobs_file"
  printf '\nCommands:\n'
  idx=0
  while IFS= read -r value; do
    [[ -n "$value" ]] || continue
    idx=$((idx+1))
    cmd=("$command_name" "${pass_args[@]}")
    if [[ "$level" == 1 ]]; then
      cmd+=(--subject "$value")
    elif [[ "$level" == 2 ]]; then
      IFS=$'\t' read -r job_subject job_session job_task job_contrast <<< "$value"
      cmd+=(--subject "$job_subject")
      [[ -z "$job_session" ]] || cmd+=(--session "$job_session")
      [[ -z "$job_task" ]] || cmd+=(--task "$job_task")
      cmd+=(--contrast "$job_contrast")
      cmd+=(--manifest-out "${manifest_parts_dir}/job-${idx}.tsv")
    fi
    printf '[%d] ' "$idx"
    print_command "${cmd[@]}"
  done < "$jobs_file"
  if [[ "$run_local" -eq 0 ]]; then
    printf '\nWould submit:\n'
    printf 'sbatch --partition=%q --array=%q --cpus-per-task=%q --job-name=%q --output=%q %q\n' \
      "$queue" "$array_spec" "$n_cpus" "$job_name" "$work_dir/${job_name}_%A_%a.out" "$runner"
    if [[ "$level" == 2 && "$level2_write_manifest" -eq 1 ]]; then
      printf 'then submit merge job with dependency=afterok:<array_job_id>: %q\n' "$merge_runner"
    elif [[ "$level" == 2 ]]; then
      printf 'call_feat2 --dry-run is active; no manifest merge job would be submitted.\n'
    fi
  elif [[ "$level" == 2 && "$level2_write_manifest" -eq 1 ]]; then
    printf '\nAfter local jobs: bash %q\n' "$merge_runner"
  elif [[ "$level" == 2 ]]; then
    printf '\ncall_feat2 --dry-run is active; no manifest merge would be performed.\n'
  fi
  exit 0
fi

if [[ "$run_local" -eq 1 ]]; then
  print_summary
  printf 'Running with a local concurrency cap of %s.\n' "$max_running"

  running=0
  failed=0
  pids=()

  wait_one() {
    local pid
    # wait -n is available in modern bash. Fall back to waiting for the oldest PID.
    if help wait 2>/dev/null | grep -q -- '-n'; then
      if ! wait -n; then failed=1; fi
    else
      pid="${pids[0]}"
      if ! wait "$pid"; then failed=1; fi
      pids=("${pids[@]:1}")
    fi
    running=$((running-1))
  }

  idx=0
  while IFS= read -r value; do
    [[ -n "$value" ]] || continue
    idx=$((idx+1))
    while (( running >= max_running )); do wait_one; done
    SLURM_ARRAY_TASK_ID="$idx" bash "$runner" &
    pids+=("$!")
    running=$((running+1))
  done < "$jobs_file"
  while (( running > 0 )); do wait_one; done

  if [[ "$failed" -ne 0 ]]; then
    exit "$failed"
  fi

  if [[ "$level" == 2 && "$level2_write_manifest" -eq 1 ]]; then
    bash "$merge_runner"
  elif [[ "$level" == 2 ]]; then
    printf '\nLevel-2 call_feat2 dry run: no manifest fragments were written; skipping manifest merge.\n'
  fi

  exit 0
fi

submit_output="$(
  sbatch \
    --partition="$queue" \
    --array="$array_spec" \
    --cpus-per-task="$n_cpus" \
    --job-name="$job_name" \
    --output="$work_dir/${job_name}_%A_%a.out" \
    "$runner"
)"
printf '%s\n' "$submit_output"

if [[ "$level" == 2 && "$level2_write_manifest" -eq 1 ]]; then
  array_job_id="$(awk '{print $NF}' <<< "$submit_output")"
  [[ "$array_job_id" =~ ^[0-9]+$ ]] || {
    err "Could not parse SLURM array job ID from: $submit_output"
    exit 1
  }

  merge_submit="$(
    sbatch \
      --partition="$queue" \
      --dependency="afterok:${array_job_id}" \
      --cpus-per-task=1 \
      --job-name="${job_name}_merge" \
      --output="$work_dir/${job_name}_merge_%j.out" \
      "$merge_runner"
  )"
  printf '%s\n' "$merge_submit"
elif [[ "$level" == 2 ]]; then
  printf 'Level-2 call_feat2 dry run: no manifest merge job submitted.\n'
fi

#-----------------------------------------------------------------------------
# Calculate time spent using 'let'
end_timer
