def _panic_dirs(path: Path) -> list[Path]:
    path = path.resolve()
    if path.name == "panic" and path.parent.name == "derivatives":
        return [path]
    direct = path / "derivatives" / "panic"
    if direct.is_dir():
        return [direct.resolve()]
    return sorted(
        p.resolve()
        for p in path.rglob("panic")
        if p.is_dir() and p.parent.name == "derivatives"
    )


def _path_entities(parts: list[str]) -> dict[str, str]:
    """Extract arbitrary key-value entities from path components.

    Examples
    --------
    ``sub-015/model-LSA/source-halfpipe/roi-brain/searchlight`` becomes::

        {
            "sub": "015",
            "model": "LSA",
            "source": "halfpipe",
            "roi": "brain",
        }

    Components without a hyphen (e.g. ``searchlight``) are ignored. The first
    occurrence of an entity wins so deeper implementation directories cannot
    silently overwrite acquisition/analysis metadata.
    """
    entities: dict[str, str] = {}

    for part in parts:
        if "-" not in part:
            continue

        key, value = part.split("-", 1)
        key = key.strip()
        value = value.strip()

        if not key or not value:
            continue

        entities.setdefault(key, value)

    return entities


def _subject_from_path(path: Path) -> str:
    for part in path.parts:
        match = re.fullmatch(r"sub-([^/]+)", part)
        if match:
            return match.group(1)
    return ""


def _session_from_path(path: Path) -> str:
    for part in path.parts:
        match = re.fullmatch(r"ses-([^/]+)", part)
        if match:
            return match.group(1)
    return ""


def _find_transform(
    *,
    xfm_dir: Path,
    subject: str,
    session: str,
    tpl_space: str,
) -> Path:
    subject_token = f"sub-{subject}"
    session_token = f"ses-{session}" if session else ""

    candidates = []
    for path in xfm_dir.rglob(
        f"*from-T1w_to-{tpl_space}_mode-image_xfm.h5"
    ):
        text = str(path)
        if subject_token not in text:
            continue
        if session_token and session_token not in text:
            continue
        candidates.append(path.resolve())

    candidates = sorted(set(candidates))
    if not candidates:
        raise click.ClickException(
            f"No T1w→{tpl_space} H5 transform found for sub-{subject}"
            + (f" ses-{session}" if session else "")
            + f" under {xfm_dir}"
        )
    if len(candidates) > 1:
        raise click.ClickException(
            f"Multiple T1w→{tpl_space} transforms found for sub-{subject}"
            + (f" ses-{session}" if session else "")
            + ":\n  " + "\n  ".join(map(str, candidates))
        )
    return candidates[0]


def _template_candidate(
    tpl_home: Path,
    tpl_space: str,
    tpl_res: int,
    *,
    suffix: str,
) -> Path:
    root = tpl_home / f"tpl-{tpl_space}"
    res = f"{tpl_res:02d}"
    preferred = [
        root / f"tpl-{tpl_space}_res-{res}_desc-brain_{suffix}.nii.gz",
        root / f"tpl-{tpl_space}_res-{res}_{suffix}.nii.gz",
        root / f"tpl-{tpl_space}_res-{tpl_res}_desc-brain_{suffix}.nii.gz",
        root / f"tpl-{tpl_space}_res-{tpl_res}_{suffix}.nii.gz",
    ]
    for path in preferred:
        if path.is_file():
            return path.resolve()

    matches = sorted(root.glob(f"tpl-{tpl_space}_res-*_{suffix}.nii.gz"))
    if len(matches) == 1:
        return matches[0].resolve()

    raise click.ClickException(
        f"Could not resolve TemplateFlow {suffix} for "
        f"{tpl_space}:res-{tpl_res} under {tpl_home}"
    )


def _registered_output(map_file: Path, tpl_space: str, tpl_res: int) -> Path:
    name = map_file.name
    if name.endswith(".nii.gz"):
        stem = name[:-7]
    else:
        stem = map_file.stem
    return map_file.with_name(
        f"{stem}_space-{tpl_space}_res-{tpl_res:02d}.nii.gz"
    )


def rebuild_manifest(
    *,
    panic_dir: Path,
    map_name: str,
    xfm_dir: Path | None,
    tpl_space: str,
    tpl_res: int,
    search_root: Path | None = None,
) -> Path:
    panic_dir = panic_dir.resolve()
    dataset_dir = panic_dir.parent.parent
    default_xfm_dir = dataset_dir / "derivatives" / "fmriprep"
    xfm_root = (xfm_dir or default_xfm_dir).resolve()

    discovery_root = (
        Path(search_root).resolve()
        if search_root is not None
        else panic_dir
    )

    try:
        discovery_root.relative_to(panic_dir)
    except ValueError as error:
        raise click.ClickException(
            f"--manifest-path must be inside the panic directory:\n"
            f"  panic: {panic_dir}\n"
            f"  path:  {discovery_root}"
        ) from error

    maps = sorted(
        path.resolve()
        for path in discovery_root.rglob(map_name)
        if "randomise" not in path.parts
    )
    if not maps:
        raise click.ClickException(
            f"No {map_name!r} files found below {discovery_root}"
        )

    records = []
    for map_file in maps:
        relative = map_file.relative_to(panic_dir)
        parts = list(relative.parts)
        analysis = parts[0] if parts else ""

        # Parse every BIDS-like key-value path component rather than assuming
        # a fixed vocabulary such as method/source/roi. This preserves
        # model-LSA, classifier-SVM, fold-01, metric-accuracy, etc.
        path_entities = _path_entities(parts[:-1])

        subject = (
            path_entities.pop("sub", "")
            or _subject_from_path(map_file)
        )
        session = (
            path_entities.pop("ses", "")
            or _session_from_path(map_file)
        )
        if not subject:
            click.echo(
                f"[WARN] Could not infer subject from {map_file}; skipping.",
                err=True,
            )
            continue

        transform = _find_transform(
            xfm_dir=xfm_root,
            subject=subject,
            session=session,
            tpl_space=tpl_space,
        )

        record = {
            "subject": subject,
            "session": session,
            "analysis": analysis,
            **path_entities,
            "map_type": map_file.name.removesuffix(".nii.gz"),
            "map_file": str(map_file),
            "input_space": "T1w",
            "transform_file": str(transform),
            "template_space": tpl_space,
            "template_res": str(tpl_res),
            "registered_file": str(
                _registered_output(map_file, tpl_space, tpl_res)
            ),
            "dataset": dataset_dir.name,
            "dataset_dir": str(dataset_dir),
            "panic_dir": str(panic_dir),
            "xfm_dir": str(xfm_root),
        }
        records.append(record)

    if not records:
        raise click.ClickException(
            f"No usable randomise inputs were discovered below {panic_dir}"
        )

    manifest = panic_dir / "randomise_manifest.tsv"
    table = pd.DataFrame.from_records(records)
    preferred_sort = [
        "analysis",
        "model",
        "method",
        "source",
        "roi",
        "task",
        "subject",
        "session",
    ]
    sort_columns = [
        column
        for column in preferred_sort
        if column in table.columns
    ]
    extra_entity_columns = [
        column
        for column in table.columns
        if column not in sort_columns
        and column not in {
            "map_type",
            "map_file",
            "input_space",
            "transform_file",
            "template_space",
            "template_res",
            "registered_file",
            "dataset",
            "dataset_dir",
            "panic_dir",
            "xfm_dir",
        }
    ]
    table = table.sort_values(
        sort_columns + extra_entity_columns,
        kind="stable",
    )
    temporary = panic_dir / f".randomise_manifest.{os.getpid()}.tmp"
    table.to_csv(temporary, sep="\t", index=False)
    temporary.replace(manifest)

    click.echo(
        f"Rebuilt randomise manifest: {manifest} "
        f"({len(table)} map(s), {table['subject'].nunique()} subject(s))"
    )
    return manifest


def register_rows(
    table: pd.DataFrame,
    *,
    tpl_home: Path,
    tpl_space: str,
    tpl_res: int,
    max_running: int,
    dry_run: bool,
) -> pd.DataFrame:
    template = _template_candidate(
        tpl_home.resolve(),
        tpl_space,
        tpl_res,
        suffix="T1w",
    )

    command_name = shutil.which("call_antsapplytransforms")
    if command_name is None:
        raise click.ClickException(
            "Required command not found on PATH: call_antsapplytransforms"
        )

    table = table.copy()

    def one(index: int):
        row = table.loc[index]
        source = Path(row["map_file"]).resolve()
        transform = Path(row["transform_file"]).resolve()
        target_text = str(row.get("registered_file", "")).strip()
        target = (
            Path(target_text).resolve()
            if target_text
            else _registered_output(source, tpl_space, tpl_res)
        )

        if target.is_file():
            return index, str(target), "reused"

        command = [
            command_name,
            str(template),
            str(source),
            str(target),
            str(transform),
        ]
        click.echo(" ".join(shlex.quote(item) for item in command))
        if not dry_run:
            target.parent.mkdir(parents=True, exist_ok=True)
            subprocess.run(command, check=True)
        return index, str(target), "created"

    workers = max(1, int(max_running))
    results = []
    if workers == 1:
        for index in table.index:
            results.append(one(index))
    else:
        with ThreadPoolExecutor(max_workers=workers) as pool:
            futures = [pool.submit(one, index) for index in table.index]
            for future in as_completed(futures):
                results.append(future.result())

    for index, target, _status in results:
        table.at[index, "registered_file"] = target
        table.at[index, "template_space"] = tpl_space
        table.at[index, "template_res"] = str(tpl_res)

    return table


def _safe(value: str) -> str:
    value = re.sub(r"[^A-Za-z0-9._+-]+", "-", str(value).strip())
    return value.strip("-") or "unknown"


def _analysis_groups(
    table: pd.DataFrame,
    group_by: tuple[str, ...],
) -> list[tuple[dict[str, str], pd.DataFrame]]:
    """Split a manifest into independent randomise analyses.

    Explicit ``--group-by`` columns are used verbatim. Otherwise all
    non-subject path/entity columns are considered, while filesystem,
    registration, template and provenance columns are excluded.

    Entity columns are retained even when constant (e.g. source=halfpipe,
    roi=brain), so output names remain self-describing. Columns that are empty
    for every row are ignored.
    """
    if group_by:
        columns = list(group_by)
    else:
        reserved = {
            "subject",
            "session",
            "map_file",
            "registered_file",
            "transform_file",
            "input_space",
            "template_space",
            "template_res",
            "dataset",
            "dataset_dir",
            "panic_dir",
            "xfm_dir",
            "manifest_source",
        }

        columns = []
        if "analysis" in table.columns:
            columns.append("analysis")

        for column in table.columns:
            if column == "analysis" or column in reserved:
                continue

            values = table[column].astype(str).str.strip()
            if not values.ne("").any():
                continue

            # map_type identifies the map product rather than an acquisition
            # entity, but should separate analyses when multiple map products
            # are actually present.
            if column == "map_type" and values.nunique(dropna=False) <= 1:
                continue

            columns.append(column)

    missing = [column for column in columns if column not in table.columns]
    if missing:
        raise click.ClickException(
            "Missing --group-by column(s): " + ", ".join(missing)
        )

    if not columns:
        return [({}, table.copy())]

    groups = []
    for key, rows in table.groupby(columns, sort=True, dropna=False):
        if not isinstance(key, tuple):
            key = (key,)
        groups.append(
            (dict(zip(columns, map(str, key))), rows.copy())
        )

    return groups


@click.command(
    context_settings=CONTEXT_SETTINGS,
    epilog=(
        "Resource governance:\n\n"
        "\b\n"
        "  spinoza_randomise has two independent levels of concurrency:\n"
        "    1. analysis-level concurrency, controlled by -m/--max-running;\n"
        "    2. optional permutation-fragment concurrency inside each analysis,\n"
        "       controlled by --parallel-jobs when --parallel-randomise is used.\n\n"

        "\b\n"
        "  By default, independent analyses are submitted as a throttled SLURM\n"
        "  array. If -m is omitted, the maximum number of simultaneously running\n"
        "  analysis jobs defaults to the number of unique analysis groups in the\n"
        "  filtered manifest. For example, 12 groups with -m 4 are submitted\n"
        "  effectively as an array 0-11%4.\n\n"

        "\b\n"
        "  --local disables SLURM submission of analysis groups and instead runs\n"
        "  up to -m analyses concurrently on the current host. Registration uses\n"
        "  the same -m ceiling for concurrent transforms.\n\n"

        "\b\n"
        "  With --parallel-randomise, each analysis may additionally launch an\n"
        "  inner fsl_sub array through FSL randomise_parallel. --parallel-jobs\n"
        "  limits the number of simultaneously running permutation fragments per\n"
        "  analysis. Therefore an approximate upper bound on active permutation\n"
        "  jobs is:\n\n"
        "\b\n"
        "      max-running x parallel-jobs\n\n"

        "\b\n"
        "  For example, -m 3 --parallel-randomise --parallel-jobs 8 can allow\n"
        "  approximately 24 permutation-fragment jobs to run concurrently, in\n"
        "  addition to short-lived launcher/defragmentation jobs.\n\n"

        "\b\n"
        "  Outer analysis jobs use --queue and repeatable --slurm-arg options.\n"
        "  Inner randomise_parallel jobs use --parallel-queue, --parallel-ram,\n"
        "  --parallel-time, --parallel-resource and --parallel-extra. These are\n"
        "  passed to the scheduler configured for fsl_sub. Resource governance\n"
        "  for the two levels is intentionally separate.\n\n"

        "\b\n"
        "  If randomise reports fewer unique permutations/sign-flips than the\n"
        "  requested permutation count, parallel execution is not useful and the\n"
        "  analysis falls back to ordinary exhaustive randomise.\n\n"

        "Examples:\n\n"

        "\b\n"
        "  Typical dataset run:\n"
        "    spinoza_randomise /data/study \\\n"
        "      --rebuild-manifest \\\n"
        "      --tpl-home /mnt/d/fMRI/.templateflow \\\n"
        "      --tpl-space MNI152NLin2009cAsym \\\n"
        "      --tpl-res 2 \\\n"
        "      -m 4\n\n"

        "\b\n"
        "  SLURM resource limits for independent analyses:\n"
        "    spinoza_randomise /data/study \\\n"
        "      -m 4 \\\n"
        "      --queue main \\\n"
        "      --slurm-arg=--mem=8G \\\n"
        "      --slurm-arg=--time=04:00:00\n\n"

        "\b\n"
        "  Parallelise permutations within each analysis:\n"
        "    spinoza_randomise /data/study \\\n"
        "      -m 3 \\\n"
        "      --parallel-randomise \\\n"
        "      --parallel-jobs 8 \\\n"
        "      --parallel-ram 8000 \\\n"
        "      --parallel-time 240 \\\n"
        "      --parallel-queue main\n\n"

        "\b\n"
        "  Aggregate multiple datasets:\n"
        "    spinoza_randomise /data/all_sites \\\n"
        "      --manifest /data/all_sites \\\n"
        "      --separate-entities \\\n"
        "      --filter desc=ENIGMA \\\n"
        "      --output-dir /data/all_sites/randomise\n"
    ),
)
