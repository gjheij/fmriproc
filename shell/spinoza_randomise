    register: bool,
    max_running: int | None,
    local: bool,
    queue: str | None,
    slurm_args: tuple[str, ...],
    filters: tuple[str, ...],
    group_by: tuple[str, ...],
    output_dir: Path | None,
    covariates_file: Path | None,
    covariates: tuple[str, ...],
    demean_covariates: bool,
    group_contrasts: tuple[str, ...],
    parallel_randomise: bool,
    parallel_jobs: int | None,
    parallel_ram: int | None,
    parallel_time: int | None,
    parallel_queue: str | None,
    parallel_resources: tuple[str, ...],
    parallel_extra: tuple[str, ...],
    overwrite: bool,
    dry_run: bool,
) -> None:
    panic_dirs = _panic_dirs(path)

    rebuilt = []
    if rebuild_manifest:
        if not panic_dirs:
            raise click.ClickException(
                f"No derivatives/panic directories found under {path}"
            )
        click.echo("Rebuilding manifest")
        for panic_dir in panic_dirs:
            rebuilt.append(
                globals()["rebuild_manifest"](
                    panic_dir=panic_dir,
                    map_name=map_name,
                    xfm_dir=xfm_dir,
                    tpl_space=tpl_space,
                    tpl_res=tpl_res,
                    search_root=manifest_path_scope,
                )
            )

    if manifest_only:
        if not rebuild_manifest:
            raise click.ClickException(
                "--manifest-only requires --rebuild-manifest."
            )
        click.echo("Manifest-only mode: registration and randomise were not run.")
        for rebuilt_manifest in rebuilt:
            click.echo(f"  {rebuilt_manifest}")
        return

    if manifest_path is None:
        if len(rebuilt) == 1:
            manifest_path = rebuilt[0]
        elif len(panic_dirs) == 1:
            manifest_path = panic_dirs[0] / "randomise_manifest.tsv"
        elif rebuilt:
            manifest_path = path
        else:
            manifest_path = path

    table = load_randomise_manifest(
        manifest_path,
        separate_entities=separate_entities,
        delimiter=delimiter,
    )
    table = filter_manifest_rows(table, filters)

    if table.empty:
        raise click.ClickException("No randomise inputs remain after filtering.")

    # Grouping depends only on manifest entities, so determine the number of
    # independent randomise tasks before registration. When -m/--max-running
    # is omitted, allow every unique analysis group to run concurrently.
    groups = _analysis_groups(table, group_by)
    if not groups:
        raise click.ClickException("No randomise analysis groups were prepared.")
    if max_running is None:
        max_running = len(groups)
        click.echo(
            f"--max-running not specified; using {max_running} "
            f"(number of randomise analysis groups)."
        )

    template = _template_candidate(
        tpl_home.resolve(),
        tpl_space,
        tpl_res,
        suffix="T1w",
    )
    mask = _template_candidate(
        tpl_home.resolve(),
        tpl_space,
        tpl_res,
        suffix="mask",
    )

    if register:
        table = register_rows(
            table,
            tpl_home=tpl_home,
            tpl_space=tpl_space,
            tpl_res=tpl_res,
            max_running=max_running,
            dry_run=dry_run,
        )

        # Persist updated registration paths back to a single source manifest.
        if Path(manifest_path).is_file() and not dry_run:
            target = Path(manifest_path).resolve()
            temporary = target.with_name(f".{target.name}.{os.getpid()}.tmp")
            table.to_csv(temporary, sep="\t", index=False)
            temporary.replace(target)

    click.echo(f"Prepared {len(groups)} randomise analysis group(s).")

    if output_dir is None:
        source_panics = sorted(set(table.get("panic_dir", pd.Series(dtype=str))))
        source_panics = [value for value in source_panics if str(value).strip()]
        if len(source_panics) == 1:
            randomise_root = Path(source_panics[0]) / "randomise"
        elif len(panic_dirs) == 1:
            randomise_root = panic_dirs[0] / "randomise"
        else:
            randomise_root = path.resolve() / "randomise"
    else:
        randomise_root = output_dir.resolve()

    call_randomise = shutil.which("call_randomise")
    if call_randomise is None:
        raise click.ClickException("Required command not found on PATH: call_randomise")

    randomise_root.mkdir(parents=True, exist_ok=True)

    def prepare_group(item):
        entities, rows = item
        analysis = entities.get(
            "analysis",
            rows["analysis"].iloc[0] if "analysis" in rows.columns else "analysis",
        )
        group_dir = randomise_root / _safe(analysis)

        extras = [
            (key, value)
            for key, value in entities.items()
            if key != "analysis" and str(value).strip()
        ]
        if extras:
            group_dir = group_dir / "_".join(
                f"{_safe(key)}-{_safe(value)}"
                for key, value in extras
            )

        fragment = randomise_root / ".manifests" / (
            "_".join(
                [f"{_safe(k)}-{_safe(v)}" for k, v in entities.items()]
            ) or "analysis"
        )
        fragment = fragment.with_suffix(".tsv")
        fragment.parent.mkdir(parents=True, exist_ok=True)
        rows.to_csv(fragment, sep="\t", index=False)

        command = [
            call_randomise,
            "--manifest", str(fragment),
            "--output-dir", str(group_dir),
            "--input-column", "registered_file",
            "--mask", str(mask),
            "--background", str(template),
            "--title", str(analysis),
        ]

        if covariates_file:
            command += ["--covariates-file", str(covariates_file)]
        for covariate in covariates:
            command += ["--covariate", covariate]
        if not demean_covariates:
            command += ["--no-demean-covariates"]
        for contrast in group_contrasts:
            command += ["--group-contrast", contrast]
        if parallel_randomise:
            command += ["--parallel-randomise"]
        if parallel_jobs is not None:
            command += ["--parallel-jobs", str(parallel_jobs)]
        if parallel_ram is not None:
            command += ["--parallel-ram", str(parallel_ram)]
        if parallel_time is not None:
            command += ["--parallel-time", str(parallel_time)]
        if parallel_queue:
            command += ["--parallel-queue", parallel_queue]
        for resource in parallel_resources:
            command += ["--parallel-resource", resource]
        for extra in parallel_extra:
            command += ["--parallel-extra", extra]
        if overwrite:
            command += ["--overwrite"]
        if dry_run:
            command += ["--dry-run"]

        command += list(ctx.args)
        return entities, group_dir, command

    prepared_groups = [prepare_group(group) for group in groups]

    for entities, _group_dir, command in prepared_groups:
        click.echo("")
        click.echo("Randomise group:")
        for key, value in entities.items():
            click.echo(f"  {key:16s} {value}")
        click.echo(
            "  command          "
            + " ".join(shlex.quote(x) for x in command)
        )

    group_workers = min(max_running, len(prepared_groups))

    if local:
        if len(prepared_groups) > 1:
            click.echo(
                f"Running randomise groups locally with maximum concurrency: "
                f"{group_workers}"
            )

        def run_local_group(item):
            entities, group_dir, command = item
            if not dry_run:
                subprocess.run(command, check=True)
            return entities, group_dir

        if group_workers <= 1:
            for item in prepared_groups:
                entities, group_dir = run_local_group(item)
                label = ", ".join(
                    f"{key}={value}" for key, value in entities.items()
                ) or group_dir.name
                click.echo(f"Completed randomise group: {label}")
        else:
            with ThreadPoolExecutor(
                max_workers=group_workers,
                thread_name_prefix="randomise-group",
            ) as pool:
                future_to_group = {
                    pool.submit(run_local_group, item): item
                    for item in prepared_groups
                }
                try:
                    for future in as_completed(future_to_group):
                        try:
                            entities, group_dir = future.result()
                        except Exception:
                            for pending in future_to_group:
                                if pending is not future:
                                    pending.cancel()
                            raise
                        label = ", ".join(
                            f"{key}={value}"
                            for key, value in entities.items()
                        ) or group_dir.name
                        click.echo(f"Completed randomise group: {label}")
                finally:
                    pool.shutdown(wait=True, cancel_futures=True)

        if not dry_run:
            index = _write_randomise_report_index(
                randomise_root,
                title=f"{randomise_root.parent.name} randomise analyses",
            )
            click.echo("")
            click.echo(f"Randomise report index: {index}")
            click.echo("  To browse reports:")
            click.echo(f"    cd {randomise_root}")
            click.echo("    python -m http.server 8000")
            click.echo("  Then visit: http://localhost:8000/")
        return

    # ------------------------------------------------------------------
    # SLURM execution (default)
    # ------------------------------------------------------------------
    sbatch = shutil.which("sbatch")
    if sbatch is None and not dry_run:
        raise click.ClickException(
            "SLURM submission requested but 'sbatch' was not found on PATH. "
            "Use --local to execute call_randomise directly."
        )
    sbatch = sbatch or "sbatch"

    slurm_dir = randomise_root / ".slurm"
    log_dir = randomise_root / "logs"
    slurm_dir.mkdir(parents=True, exist_ok=True)
    log_dir.mkdir(parents=True, exist_ok=True)

    commands_file = slurm_dir / "randomise_commands.sh"
    runner_file = slurm_dir / "run_randomise_array.sh"

    command_lines = [
        " ".join(shlex.quote(token) for token in command)
        for _entities, _group_dir, command in prepared_groups
    ]
    commands_file.write_text("\n".join(command_lines) + "\n", encoding="utf-8")

    runner_file.write_text(
        "#!/usr/bin/env bash\n"
        "set -euo pipefail\n"
        f"commands_file={shlex.quote(str(commands_file))}\n"
        "line=$((SLURM_ARRAY_TASK_ID + 1))\n"
        "cmd=$(sed -n \"${line}p\" \"${commands_file}\")\n"
        "if [[ -z ${cmd} ]]; then\n"
        "  echo \"ERROR: no randomise command for array index ${SLURM_ARRAY_TASK_ID}\" >&2\n"
        "  exit 1\n"
        "fi\n"
        "echo \"[${SLURM_ARRAY_TASK_ID}] ${cmd}\"\n"
        "exec bash -lc \"${cmd}\"\n",
        encoding="utf-8",
    )
    runner_file.chmod(0o755)

    array_spec = f"0-{len(prepared_groups) - 1}%{group_workers}"

    log_file = log_dir / "randomise_%A_%a.log"

    submit = [
        sbatch,
        "--parsable",
        f"--array={array_spec}",
        "--job-name=randomise",
        f"--output={log_file}",
        f"--error={log_file}",
    ]
    if queue:
        submit += ["--partition", queue]
    submit += list(slurm_args)
    submit.append(str(runner_file))

    click.echo("")
    click.echo(
        f"Submitting {len(prepared_groups)} randomise group(s) to SLURM "
        f"with maximum concurrency {group_workers}:"
    )
    click.echo("  " + " ".join(shlex.quote(x) for x in submit))

    if dry_run:
        click.echo("DRY RUN: SLURM jobs were not submitted.")
        return

    submitted = subprocess.run(
        submit,
        check=True,
        capture_output=True,
        text=True,
    )
    array_job_id = submitted.stdout.strip().split(";", 1)[0]
    if not array_job_id:
        raise click.ClickException("sbatch did not return a randomise array job ID.")
    click.echo(f"Randomise array job: {array_job_id}")

    # Build the card index only after every array element succeeds.
    index_python = (
        "from pathlib import Path; "
        "from fmriproc.fsl import _write_randomise_report_index; "
        f"p=Path({str(randomise_root)!r}); "
        f"r=_write_randomise_report_index(p, title={f'{randomise_root.parent.name} randomise analyses'!r}); "
        "print(f'Randomise report index: {r}')"
    )
    index_submit = [
        sbatch,
        "--parsable",
        f"--dependency=afterok:{array_job_id}",
        "--job-name=randomise_index",
        f"--output={log_dir}/randomise_index_%j.log",
        f"--error={log_dir}/randomise_index_%j.log",
    ]
    if queue:
        index_submit += ["--partition", queue]
    index_submit += list(slurm_args)
    index_submit += ["--wrap", f"python -c {shlex.quote(index_python)}"]

    click.echo("Submitting dependent report-index job:")
    click.echo("  " + " ".join(shlex.quote(x) for x in index_submit))
    index_result = subprocess.run(
        index_submit,
        check=True,
        capture_output=True,
        text=True,
    )
    index_job_id = index_result.stdout.strip().split(";", 1)[0]
    click.echo(f"Report-index job:    {index_job_id}")
    click.echo(f"SLURM logs:          {log_dir}")


if __name__ == "__main__":
    main()
