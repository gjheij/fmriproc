#!/usr/bin/env python3
"""Subject-wise native PANIC configurations, locally or through Slurm.

master -m 30 -j 1 -l 8 -q intelsr_short -x '-f /project/code/panic.yml'
spinoza_decoding -s 01 --local /project -- -f /project/code/panic.yml

YAML source, method and ROI definitions are preserved; explicit overrides win.
master -j sets CPUs per subject; master -l sets concurrent subject jobs.
"""
import argparse
import copy
from datetime import datetime
import hashlib
import importlib.metadata
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

import yaml


def positive(value):
    number = int(value)
    if number < 1:
        raise argparse.ArgumentTypeError('must be a positive integer')
    return number


def config_options(parser):
    parser.add_argument('-f', '-c', '--config')
    parser.add_argument('-x', action='append', default=[], help='Legacy comma-separated KEY=VALUE overrides')
    parser.add_argument('--set', nargs='+', action='extend', default=[], metavar='KEY=VALUE')
    parser.add_argument('--unset', nargs='+', action='extend', default=[], metavar='KEY')
    method = parser.add_mutually_exclusive_group()
    method.add_argument('--lsa', dest='method', action='store_const', const='LSA')
    method.add_argument('--lss', dest='method', action='store_const', const='LSS')
    parser.add_argument('--searchlight', action='store_true')


def assign(cfg, key, value=None, remove=False):
    """Dotted mappings and PANIC list-index notation, without importing PANIC."""
    tokens = []
    for part in key.split('.'):
        match = re.fullmatch(r'([^\[\]]+)((?:\[\d+\])*)', part)
        if not match:
            raise ValueError('Invalid configuration key: ' + key)
        tokens += [match[1]] + [int(index) for index in re.findall(r'\[(\d+)\]', match[2])]
    node = cfg
    for index, token in enumerate(tokens):
        last = index == len(tokens)-1
        if isinstance(node, list) and isinstance(token, int):
            if remove and token >= len(node):
                return
            while len(node) <= token:
                node.append(None)
        elif not isinstance(node, dict) or not isinstance(token, str):
            raise ValueError('Invalid configuration path: ' + key)
        if last:
            if remove:
                if isinstance(node, dict):
                    node.pop(token, None)
                else:
                    node[token] = None
            else:
                node[token] = value
        else:
            if isinstance(node, dict) and token not in node or node[token] is None:
                if remove:
                    return
                node[token] = [] if isinstance(tokens[index+1], int) else {}
            node = node[token]


def resolve_config(args, native):
    filename = native.config or args.config
    if filename:
        filename = Path(filename).expanduser().resolve()
    else:
        filename = Path(importlib.metadata.distribution('panic').locate_file('panic/config.yml'))
    with filename.open() as stream:
        cfg = yaml.safe_load(stream)
    if not isinstance(cfg, dict):
        raise ValueError('PANIC config must be a YAML mapping')
    general = cfg.setdefault('general_settings', {})
    general.setdefault('source', 'halfpipe')
    general.setdefault('method', 'LSA')
    if args.source:
        general['source'] = args.source
    if args.method or native.method:
        general['method'] = native.method or args.method
    for layer in (args, native):
        overrides = [item.strip() for value in layer.x for item in value.split(',') if item.strip()]
        for item in overrides + layer.set:
            key, separator, raw = item.partition('=')
            if not separator:
                raise ValueError('Override requires KEY=VALUE: ' + item)
            assign(cfg, key, yaml.safe_load(raw))
    for key in args.unset + native.unset:
        assign(cfg, key, remove=True)
    return filename, cfg


def project_path(value, project):
    path = Path(value).expanduser()
    return path if path.is_absolute() else project / path


def select_subjects(selector, root):
    if selector:
        path = Path(selector)
        text = path.read_text() if path.is_file() else selector
        entries = re.split(r'[,\s]+', '\n'.join(line.split('#', 1)[0] for line in text.splitlines()))
        subjects = sorted({'sub-' + (value[4:] if value.startswith('sub-') else value) for value in entries if value})
    else:
        subjects = sorted(path.name for path in root.glob('sub-*') if path.is_dir())
    if not subjects:
        raise ValueError('No subjects found below ' + str(root))
    for subject in subjects:
        if not re.fullmatch(r'sub-[A-Za-z0-9]+', subject):
            raise ValueError('Invalid subject identifier: ' + subject)
        if not (root / subject).is_dir():
            raise ValueError('Missing beta subject directory: ' + str(root / subject))
    return subjects


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    boundary = argv.index('--') if '--' in argv else len(argv)
    wrapper, forwarded = argv[:boundary], argv[boundary+1:]
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('project', type=Path)
    parser.add_argument('-s', '--subject')
    parser.add_argument('-j', '--cpus', type=positive, default=4, help='CPUs per subject (master -j)')
    parser.add_argument('-m', '--max-running', type=positive, default=10, help='Concurrent subjects (master -l)')
    parser.add_argument('-q', '--queue', default=os.environ.get('SGE_QUEUE_LONG', 'main'))
    parser.add_argument('-d', '--source', help='Override YAML source')
    parser.add_argument('-r', '--roi-base', default='searchlight')
    parser.add_argument('--local', action='store_true', help='Run sequentially with the same frozen configs as Slurm')
    parser.add_argument('--dry-run', action='store_true', help='Prepare configs and print commands without execution')
    parser.add_argument('--overwrite', '--ow', '-o', action='store_true')
    config_options(parser)
    args = parser.parse_args(wrapper)
    extra = argparse.ArgumentParser(add_help=False)
    config_options(extra)
    native, run_args = extra.parse_known_args(forwarded)
    if any(item in ('--subject', '-s', 'run') for item in run_args):
        parser.error('Select subjects with spinoza_decoding -s before --')
    try:
        project = args.project.expanduser().resolve(strict=True)
        config_path, cfg = resolve_config(args, native)
        general = cfg['general_settings']
        source_root = project_path(general.get('beta_dir') or 'derivatives/' + general['source'], project).resolve()
        if not source_root.is_dir():
            raise ValueError('Missing beta directory: ' + str(source_root))
        subjects = select_subjects(args.subject, source_root)
        if not args.local and len(subjects) > 99:
            raise ValueError('Select at most 99 subjects per array; split larger selections into separate submissions')
        if args.searchlight or native.searchlight:
            run_args.append('--searchlight')
        save_dir = project_path(general.get('save_dir') or 'derivatives/panic', project)
        logs = project / 'code/logs'
        logs.mkdir(parents=True, exist_ok=True)
        submission = Path(tempfile.mkdtemp(prefix='spinoza_decoding_submission.', dir=logs))
        print('=' * 99)
        print('Multivariate decoding with PANIC')
        print('Started at ' + datetime.now().astimezone().isoformat(timespec='seconds'))
        print('=' * 99)
        print('Configuration: ' + str(config_path))
        print('Beta directory: ' + str(source_root))
        print(f'Subjects: {len(subjects)}; concurrency={min(len(subjects), args.max_running) if not args.local else 1}; CPUs/job={args.cpus}')
        print('Log directory: ' + str(submission), flush=True)
        jobs = []
        executable = shutil.which('panic') or 'panic'
        for subject in subjects:
            resolved = copy.deepcopy(cfg)
            settings = resolved['general_settings']
            settings.update(project_dir=str(project), beta_dir=str(source_root), save_dir=str(save_dir))
            settings['overwrite'] = args.overwrite or bool(settings.get('overwrite', False))
            resolved.setdefault('decoding_settings', {}).setdefault('parallel', {})['n_jobs'] = args.cpus
            settings['tmp_dir'] = str(project_path(settings.get('tmp_dir') or '.cache/panic', project) / submission.name / subject)
            if resolved.get('roi_dict') is None:
                roi = project / 'derivatives/rois' / subject
                resolved['roi_dict'] = str(roi / args.roi_base if '--searchlight' in run_args else roi)
            elif isinstance(resolved['roi_dict'], str):
                resolved['roi_dict'] = str(project_path(resolved['roi_dict'].format(subject=subject), project))
            frozen = submission / (subject + '.yml')
            frozen.write_text(yaml.safe_dump(resolved, sort_keys=False))
            frozen.chmod(0o444)
            command = [executable, '-c', str(frozen), 'run', '--subject', subject, *run_args]
            jobs.append(dict(subject=subject, config=str(frozen),
                             config_sha256=hashlib.sha256(frozen.read_bytes()).hexdigest(), command=command))
        versions = {}
        for package in ('panic', 'stglm', 'fmriproc'):
            try:
                versions[package] = importlib.metadata.version(package)
            except importlib.metadata.PackageNotFoundError:
                versions[package] = 'not installed'
        (submission / 'submission.json').write_text(json.dumps(dict(config=str(config_path), beta_dir=str(source_root),
                                                                  versions=versions, jobs=jobs), indent=2))
        (submission / 'subjects.txt').write_text('\n'.join(subjects) + '\n')
        runner = submission / 'panic_array_runner.sh'
        lines = ['#!/usr/bin/env bash', 'set -eo pipefail',
                 'if [[ -n "${SETUP_FILE:-}" && -f "$SETUP_FILE" ]]; then source "$SETUP_FILE"; fi',
                 'set -u',
                 'case "${SLURM_ARRAY_TASK_ID:?}" in']
        for index, job in enumerate(jobs, 1):
            lines.append(f'  {index}) exec ' + shlex.join(job['command']) + ' ;;')
        lines += ['  *) echo "Invalid array index" >&2; exit 1 ;;', 'esac']
        runner.write_text('\n'.join(lines) + '\n')
        runner.chmod(0o555)
        submit = ['sbatch', '--parsable', '--partition=' + args.queue,
                  f'--array=1-{len(jobs)}%{min(len(jobs), args.max_running)}',
                  f'--cpus-per-task={args.cpus}', '--job-name=panic',
                  '--output=' + str(submission / 'panic_%A_%a.out'), str(runner)]
        if args.dry_run:
            for job in jobs:
                print(shlex.join(job['command']))
            if not args.local:
                print('Would submit: ' + shlex.join(submit))
        elif args.local:
            for job in jobs:
                log = submission / (job['subject'] + '.out')
                print('Running ' + job['subject'] + '; log: ' + str(log), flush=True)
                with log.open('w') as stream:
                    subprocess.run(job['command'], stdout=stream, stderr=subprocess.STDOUT, check=True)
        else:
            result = subprocess.run(submit, text=True, capture_output=True, check=True)
            (submission / 'slurm_job_id.txt').write_text(result.stdout)
            print('Submitted Slurm job ' + result.stdout.strip())
        print('Log directory: ' + str(submission))
    except (OSError, ValueError, KeyError, yaml.YAMLError, subprocess.CalledProcessError, importlib.metadata.PackageNotFoundError) as error:
        parser.exit(1, 'ERROR: ' + str(error) + '\n' + str(getattr(error, 'stderr', '') or ''))


if __name__ == '__main__':
    main()
