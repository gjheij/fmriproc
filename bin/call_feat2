#!/usr/bin/env python3
"""Create within-subject second-level fixed-effects analyses from a call_feat manifest."""
from __future__ import annotations

import subprocess
from pathlib import Path

import click
import pandas as pd

from fmriproc.fsl import (
    _normalize_selector,
    _entity_text,
    _safe_label,
    run_fixed_effects_group
)

REQUIRED_MANIFEST_COLUMNS = {
    "subject", "session", "task", "run", "run_label", "cope",
    "contrast_name", "canonical_name", "cope_file", "varcope_file",
}


@click.command(
    context_settings={"show_default": True},
    help=(
        "Combine run-level call_feat outputs into within-subject fixed-effects "
        "second-level analyses. Rows are grouped by subject, session, task, "
        "and canonical contrast name."
    ),
    epilog=(
        "Examples:\n\n"
        "\b\n"
        "  Combine all eligible runs and contrasts:\n"
        "    call_feat2 \\\n"
        "      --manifest /data/study/derivatives/feat/level1/contrast_manifest.tsv \\\n"
        "      --output-dir /data/study/derivatives/feat/level2\n\n"

        "\b\n"
        "  Process one subject and one canonical contrast:\n"
        "    call_feat2 ... \\\n"
        "      --subject 22 \\\n"
        "      --contrast 'USo>USm'\n\n"

        "\b\n"
        "  Restrict inputs to selected runs:\n"
        "    call_feat2 ... \\\n"
        "      --run 1 \\\n"
        "      --run 3 \\\n"
        "      --run 5\n\n"

        "\b\n"
        "  Print commands without writing outputs:\n"
        "    call_feat2 ... \\\n"
        "      --dry-run \\\n"

    ),
)
@click.option("--manifest", "manifest_path", required=True, type=click.Path(exists=True, dir_okay=False, path_type=Path), help="First-level contrast_manifest.tsv produced by call_feat.")
@click.option("--output-dir", required=True, type=click.Path(file_okay=False, path_type=Path), help="Directory for subject-level fixed-effects outputs.")
@click.option("--subject", "subjects", multiple=True, help="Subject without sub-. Repeatable or comma-separated.")
@click.option("--session", "sessions", multiple=True, help="Session without ses-. Repeatable or comma-separated.")
@click.option("--task", "tasks", multiple=True, help="Task without task-. Repeatable or comma-separated.")
@click.option("--run", "runs", multiple=True, help="Run label. Repeatable or comma-separated.")
@click.option("--contrast", "canonical_contrasts", multiple=True, help="Canonical contrast name. Repeatable.")
@click.option("--min-runs", type=click.IntRange(min=1), default=2, help="Minimum first-level inputs required per fixed-effects analysis.")
@click.option("--overwrite", is_flag=True, help="Replace existing second-level output directories.")
@click.option("--dry-run", is_flag=True, help="Validate inputs and print FSL commands without writing outputs.")
def main(manifest_path: Path, output_dir: Path, subjects: tuple[str, ...], sessions: tuple[str, ...], tasks: tuple[str, ...], runs: tuple[str, ...], canonical_contrasts: tuple[str, ...], min_runs: int, overwrite: bool, dry_run: bool) -> None:
    manifest_path = manifest_path.resolve()
    output_dir = output_dir.resolve()
    manifest = pd.read_csv(manifest_path, sep="\t", dtype=str, keep_default_na=False)

    missing = REQUIRED_MANIFEST_COLUMNS - set(manifest.columns)
    if missing:
        raise click.ClickException("Manifest is missing columns: " + ", ".join(sorted(missing)))
    if "feat_dir" not in manifest.columns:
        manifest["feat_dir"] = manifest["cope_file"].map(lambda v: str(Path(v).parent.parent))

    selectors = {
        "subject": _normalize_selector(subjects),
        "session": _normalize_selector(sessions),
        "task": _normalize_selector(tasks),
        "run": _normalize_selector(runs),
        "canonical_name": set(canonical_contrasts),
    }
    for column, selected in selectors.items():
        if selected:
            manifest = manifest.loc[manifest[column].isin(selected)]
    if manifest.empty:
        raise click.ClickException("No manifest rows remain after filtering.")

    manifest = manifest.drop_duplicates(subset=["run_label", "canonical_name", "cope_file", "varcope_file"]).copy()
    manifest["_run_numeric"] = pd.to_numeric(manifest["run"], errors="coerce")
    manifest = manifest.sort_values(
        ["subject", "session", "task", "canonical_name", "_run_numeric", "run", "run_label"],
        kind="stable", na_position="last",
    ).drop(columns="_run_numeric")

    records: list[dict[str, object]] = []
    completed = skipped = 0
    group_cols = ["subject", "session", "task", "canonical_name"]
    for key, rows in manifest.groupby(group_cols, sort=True, dropna=False):
        subject, session, task, canonical_name = map(_entity_text, key)
        parts = [f"sub-{subject}"]
        if session:
            parts.append(f"ses-{session}")
        parts.append(f"task-{task}")
        group_label = "_".join(parts)
        group_output = output_dir / f"{group_label}_fixedfx.gfeat" / f"contrast-{_safe_label(canonical_name)}.feat"

        click.echo("")
        click.echo(f"[{group_label}; canonical={canonical_name}; inputs={len(rows)}]")
        if len(rows) < min_runs:
            click.echo(f"[WARN] Only {len(rows)} input(s); --min-runs={min_runs}. Skipping.", err=True)
            skipped += 1
            continue
        try:
            result = run_fixed_effects_group(rows, group_output, canonical_name, overwrite, dry_run)
            records.append({
                "subject": subject,
                "session": session,
                "task": task,
                "canonical_name": canonical_name,
                **result,
            })
            completed += 1
        except (click.ClickException, OSError, ValueError, subprocess.CalledProcessError) as error:
            click.echo(f"[ERROR] {group_label}; {canonical_name}: {error}", err=True)
            skipped += 1

    if records and not dry_run:
        output_dir.mkdir(parents=True, exist_ok=True)
        level2_manifest = output_dir / "contrast_manifest_level2.tsv"
        temp = level2_manifest.with_suffix(".tsv.tmp")
        pd.DataFrame.from_records(records).to_csv(temp, sep="\t", index=False)
        temp.replace(level2_manifest)
        click.echo(f"\nSecond-level manifest: {level2_manifest}")

    click.echo(f"\nFinished: {completed} fixed-effects analysis/analyses completed; {skipped} skipped or failed.")
    if completed == 0:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
