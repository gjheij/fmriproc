#!/usr/bin/env python3
"""Create within-subject second-level fixed-effects analyses from a call_feat manifest."""
from __future__ import annotations

import os
import subprocess
from pathlib import Path

import click
import pandas as pd

from fmriproc.fsl import (
    _entity_text,
    _maybe_write_gfeat_report_index,
    _normalize_selector,
    _safe_label,
    run_fixed_effects_group,
)

REQUIRED_MANIFEST_COLUMNS = {
    "subject", "session", "task", "run", "run_label", "cope",
    "contrast_name", "canonical_name", "cope_file", "varcope_file",
}


@click.command(
    context_settings={"show_default": True},
    help=(
        "Combine run-level call_feat outputs into within-subject fixed-effects "
        "second-level analyses. Rows are grouped by subject, session, task, "
        "and canonical contrast name."
    ),
    epilog=(
        "Examples:\n\n"
        "\b\n"
        "  Combine all eligible runs and contrasts:\n"
        "    call_feat2 \\\n"
        "      --manifest /data/study/derivatives/feat/level1/contrast_manifest.tsv \\\n"
        "      --output-dir /data/study/derivatives/feat/level2\n\n"

        "\b\n"
        "  Process one subject and one canonical contrast:\n"
        "    call_feat2 ... \\\n"
        "      --subject 22 \\\n"
        "      --contrast 'USo>USm'\n\n"

        "\b\n"
        "  Restrict inputs to selected runs:\n"
        "    call_feat2 ... \\\n"
        "      --run 1 \\\n"
        "      --run 3 \\\n"
        "      --run 5\n\n"

        "\b\n"
        "  Print commands without writing outputs:\n"
        "    call_feat2 ... \\\n"
        "      --dry-run \\\n"

    ),
)
@click.option("--manifest", "manifest_path", required=True, type=click.Path(exists=True, dir_okay=False, path_type=Path), help="First-level contrast_manifest.tsv produced by call_feat.")
@click.option("--output-dir", required=True, type=click.Path(file_okay=False, path_type=Path), help="Directory for subject-level fixed-effects outputs.")
@click.option("--manifest-out", type=click.Path(dir_okay=False, path_type=Path), default=None, help="Output manifest path. Default = <output-dir>/contrast_manifest_level2.tsv. Useful for parallel jobs writing separate manifest fragments.")
@click.option("--subject", "subjects", multiple=True, help="Subject without sub-. Repeatable or comma-separated.")
@click.option("--session", "sessions", multiple=True, help="Session without ses-. Repeatable or comma-separated.")
@click.option("--task", "tasks", multiple=True, help="Task without task-. Repeatable or comma-separated.")
@click.option("--run", "runs", multiple=True, help="Run label. Repeatable or comma-separated.")
@click.option("--contrast", "canonical_contrasts", multiple=True, help="Canonical contrast name. Repeatable.")
@click.option("--min-runs", type=click.IntRange(min=1), default=2, help="Minimum first-level inputs required per fixed-effects analysis.")
@click.option("--rebuild-contrast-manifest", is_flag=True, help="Reconstruct contrast_manifest_level2.tsv from existing fixed-effects outputs without rerunning analyses. The first-level --manifest is used to recover grouping and input counts.")
@click.option("--overwrite", is_flag=True, help="Replace existing second-level output directories. Without this flag, complete existing outputs are reused and entered into the manifest.")
@click.option("--dry-run", is_flag=True, help="Validate inputs and print FSL commands without writing outputs.")
def main(manifest_path: Path, output_dir: Path, manifest_out: Path | None, subjects: tuple[str, ...], sessions: tuple[str, ...], tasks: tuple[str, ...], runs: tuple[str, ...], canonical_contrasts: tuple[str, ...], min_runs: int, rebuild_contrast_manifest: bool, overwrite: bool, dry_run: bool) -> None:
    manifest_path = manifest_path.resolve()
    output_dir = output_dir.resolve()

    if rebuild_contrast_manifest and overwrite:
        raise click.ClickException(
            "--rebuild-contrast-manifest cannot be combined with --overwrite."
        )

    manifest = pd.read_csv(manifest_path, sep="\t", dtype=str, keep_default_na=False)

    missing = REQUIRED_MANIFEST_COLUMNS - set(manifest.columns)
    if missing:
        raise click.ClickException("Manifest is missing columns: " + ", ".join(sorted(missing)))
    if "feat_dir" not in manifest.columns:
        manifest["feat_dir"] = manifest["cope_file"].map(lambda v: str(Path(v).parent.parent))

    selectors = {
        "subject": _normalize_selector(subjects),
        "session": _normalize_selector(sessions),
        "task": _normalize_selector(tasks),
        "run": _normalize_selector(runs),
        "canonical_name": set(canonical_contrasts),
    }
    for column, selected in selectors.items():
        if selected:
            manifest = manifest.loc[manifest[column].isin(selected)]
    if manifest.empty:
        raise click.ClickException("No manifest rows remain after filtering.")

    manifest = manifest.drop_duplicates(subset=["run_label", "canonical_name", "cope_file", "varcope_file"]).copy()
    manifest["_run_numeric"] = pd.to_numeric(manifest["run"], errors="coerce")
    manifest = manifest.sort_values(
        ["subject", "session", "task", "canonical_name", "_run_numeric", "run", "run_label"],
        kind="stable", na_position="last",
    ).drop(columns="_run_numeric")

    records: list[dict[str, object]] = []
    completed = reused = skipped = failed = 0
    group_cols = ["subject", "session", "task", "canonical_name"]
    for key, rows in manifest.groupby(group_cols, sort=True, dropna=False):
        subject, session, task, canonical_name = map(_entity_text, key)
        parts = [f"sub-{subject}"]
        if session:
            parts.append(f"ses-{session}")
        parts.append(f"task-{task}")
        group_label = "_".join(parts)
        group_output = output_dir / f"{group_label}_fixedfx.gfeat" / f"contrast-{_safe_label(canonical_name)}.feat"

        click.echo("")
        click.echo(f"[{group_label}; canonical={canonical_name}; inputs={len(rows)}]")
        if len(rows) < min_runs:
            click.echo(f"[WARN] Only {len(rows)} input(s); --min-runs={min_runs}. Skipping.", err=True)
            skipped += 1
            continue
        try:
            output_exists = group_output.exists()

            if rebuild_contrast_manifest:
                if not output_exists:
                    click.echo(
                        f"[WARN] Existing fixed-effects output not found; skipping: "
                        f"{group_output}",
                        err=True,
                    )
                    skipped += 1
                    continue

                click.echo(
                    f"Rebuilding manifest entry from existing output: {group_output}"
                )

            if (output_exists and not overwrite and not dry_run) or rebuild_contrast_manifest:
                stats_dir = group_output / "stats"
                cope_file = stats_dir / "cope1.nii.gz"
                varcope_file = stats_dir / "varcope1.nii.gz"
                tstat_file = stats_dir / "tstat1.nii.gz"
                zstat_file = stats_dir / "zstat1.nii.gz"

                required_outputs = (
                    cope_file,
                    varcope_file,
                    tstat_file,
                    zstat_file,
                )
                missing_outputs = [
                    str(path)
                    for path in required_outputs
                    if not path.is_file()
                ]
                if missing_outputs:
                    raise click.ClickException(
                        "Existing fixed-effects output is incomplete; missing "
                        + ", ".join(missing_outputs)
                    )

                if not rebuild_contrast_manifest:
                    click.echo(
                        f"Reusing existing fixed-effects output: {group_output}"
                    )

                # Preserve any useful provenance from a previous level-2
                # manifest row, but never trust it for filesystem-derived
                # fields. Old manifests may contain blank current fields or
                # legacy aliases such as output_dir/number_of_runs.
                reused_record: dict[str, object] = {}
                existing_manifest = output_dir / "contrast_manifest_level2.tsv"

                if existing_manifest.is_file():
                    try:
                        previous = pd.read_csv(
                            existing_manifest,
                            sep="\t",
                            dtype=str,
                            keep_default_na=False,
                        )
                    except pd.errors.EmptyDataError:
                        previous = pd.DataFrame()

                    required_keys = {
                        "subject",
                        "session",
                        "task",
                        "canonical_name",
                    }
                    if (
                        not previous.empty
                        and required_keys.issubset(previous.columns)
                    ):
                        matched = previous.loc[
                            (previous["subject"] == subject)
                            & (previous["session"] == session)
                            & (previous["task"] == task)
                            & (previous["canonical_name"] == canonical_name)
                        ]
                        if len(matched) == 1:
                            reused_record.update(matched.iloc[0].to_dict())

                # Existing validated filesystem state is authoritative.
                reused_record.update(
                    {
                        "subject": subject,
                        "session": session,
                        "task": task,
                        "canonical_name": canonical_name,
                        "number_of_inputs": int(len(rows)),
                        "second_level_dir": str(group_output),
                        "cope_file": str(cope_file),
                        "varcope_file": str(varcope_file),
                        "tstat_file": str(tstat_file),
                        "zstat_file": str(zstat_file),
                    }
                )

                # Remove schema aliases emitted by older call_feat2 versions.
                reused_record.pop("number_of_runs", None)
                reused_record.pop("output_dir", None)

                records.append(reused_record)

                # Keep the subject-level .gfeat browser current even when this
                # contrast was reused or recovered during a manifest rebuild.
                _maybe_write_gfeat_report_index(group_output)

                reused += 1
                continue

            result = run_fixed_effects_group(
                rows,
                group_output,
                canonical_name,
                overwrite,
                dry_run
            )

            records.append({
                "subject": subject,
                "session": session,
                "task": task,
                "canonical_name": canonical_name,
                **result,
            })

            if not dry_run:
                # Refresh the visual contrast browser in the parent fixedfx
                # .gfeat. The shared helper uses locking + atomic replacement,
                # so independent array jobs can safely update the same index.
                _maybe_write_gfeat_report_index(group_output)

            completed += 1

        except (
            click.ClickException,
            OSError,
            ValueError,
            subprocess.CalledProcessError,
        ) as error:
            click.echo(
                f"[ERROR] {group_label}; {canonical_name}: {error}",
                err=True,
            )
            failed += 1

    if records and not dry_run:
        output_dir.mkdir(parents=True, exist_ok=True)

        if manifest_out is None:
            level2_manifest = output_dir / "contrast_manifest_level2.tsv"
        else:
            level2_manifest = manifest_out.resolve()

        level2_manifest.parent.mkdir(parents=True, exist_ok=True)

        # Use a process-specific temporary file so independent array tasks can
        # safely write separate manifest fragments.
        temp = level2_manifest.with_name(
            f"{level2_manifest.name}.tmp-{os.getpid()}"
        )
        table = pd.DataFrame.from_records(records)

        preferred = [
            "subject",
            "session",
            "task",
            "canonical_name",
            "number_of_inputs",
            "second_level_dir",
            "cope_file",
            "varcope_file",
            "tstat_file",
            "zstat_file",
        ]
        ordered = [
            column for column in preferred
            if column in table.columns
        ]
        ordered.extend(
            column for column in table.columns
            if column not in ordered
        )
        table = table.loc[:, ordered]

        table.to_csv(temp, sep="\t", index=False)
        temp.replace(level2_manifest)

        label = (
            "Rebuilt second-level manifest"
            if rebuild_contrast_manifest
            else "Second-level manifest"
        )
        click.echo(f"\n{label}: {level2_manifest}")

    if rebuild_contrast_manifest:
        click.echo(
            f"\nFinished manifest rebuild: {reused} existing analysis/analyses "
            f"recovered; {skipped} missing/skipped; {failed} failed."
        )
    else:
        click.echo(
            f"\nFinished: {completed} fixed-effects analysis/analyses completed; "
            f"{reused} reused; {skipped} skipped; {failed} failed."
        )

    if failed > 0 or (completed + reused) == 0:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
