#!/usr/bin/env bash

#-----------------------------------------------------------------------------
# source setup and helper functions
call_loadsetup
source call_bashhelper

set -euo pipefail

apply_one () {
  local interp="$1"
  local input="$2"
  local output="$3"
  local xfm="$4"

  cmd=(
    call_antsapplytransforms
    "$interp"
    "$template"
    "$input"
    "$output"
    "$xfm"
  )

  print_cmd "${cmd[@]}" && "${cmd[@]}"
}

#-----------------------------------------------------------------------------
# Create help text
usage() {
    cat <<USAGE

---------------------------------------------------------------------------------------------------
call_ants2featreg

Create an FSL FEAT-style reg directory from ANTs/fMRIPrep registration outputs. This script converts
a T1w-to-MNI ANTs transform and a BOLD-to-T1w transform into the files expected by FEAT, including
highres2standard.mat, highres2standard_warp.nii.gz, example_func2highres.mat, and the corresponding
resampled images.

Usage:
  call_ants2featreg [arguments] [options]

Mandatory (required input):
  --t1w <image>                  T1w/highres image
  --boldref <image>              FEAT example_func/BOLD reference image
  --bold-to-t1w <transform>      BOLD-to-T1w affine transform; can be ANTs .txt or .mat

  Either provide:
  --t1w-to-mni-affine <mat>      ANTs T1w-to-MNI affine transform, e.g.,
                                 *_0GenericAffine.mat
  --t1w-to-mni-warp <warp>       ANTs T1w-to-MNI nonlinear warp, e.g.,
                                 *_1Warp.nii.gz

  Or provide:
  --t1w-to-mni-h5 <h5>           Composite ANTs/fMRIPrep .h5 transform. This will be
                                 disassembled into affine and nonlinear warp components.

Optional (flags with defaults):
  --out-dir <dir>                Output reg directory. If --feat-dir is provided and --out-dir is
                                 omitted, defaults to:
                                   <FEAT_DIR>/reg
  --anat-cache-dir <dir>         Reuse/store subject-level anatomical registration products here.
                                 Expensive T1w->template conversion is only performed when mandatory
                                 cache files are missing. The output reg directory links to these
                                 shared anatomical files but keeps functional registration files local.
  --template <image>             MNI template image. Default:
                                   \$FSLDIR/data/standard/MNI152_T1_1mm_brain.nii.gz
  --feat-dir <dir>               FEAT directory that should receive the reg folder
  --update-featreg               Run updatefeatreg after copying/creating the reg folder
  --apply-reg                    Apply ANTs transforms after updatefeatreg
                                 (--apply-featreg is retained as an alias)
  --stats-subdir stats|psc|both   Select native statistics to register. Default: stats.
                                 PSC outputs go to reg_standard/psc with their valid mask.
                                 Level-2 PSC analyses keep their statistics in stats.
  --clean                        Remove temporary files after successful completion

Caching:
  With --anat-cache-dir, these files are shared/reused:
    highres.nii.gz
    standard.nii.gz
    highres2standard.mat
    highres2standard_warp.nii.gz
    highres2standard.nii.gz

  These remain specific to each --out-dir / FEAT analysis:
    example_func.nii.gz
    example_func2highres.mat
    example_func2highres.nii.gz
    example_func2standard.mat and inverse matrices/images created by updatefeatreg

Options:
  -h|--help                      Print this help text

Outputs:
  The output reg directory will contain FEAT-compatible registration files:

    highres.nii.gz               Copy of the T1w image
    standard.nii.gz              Copy of the MNI template
    example_func.nii.gz          Copy of the BOLD reference image
    highres2standard.mat         T1w-to-MNI affine converted to FSL format
    highres2standard_warp.nii.gz Combined T1w-to-MNI affine/nonlinear warp in FSL format
    highres2standard.nii.gz      T1w image resampled to standard space
    example_func2highres.mat     BOLD-to-T1w affine converted to FSL format
    example_func2highres.nii.gz  BOLD reference resampled to T1w space

Example:
  # Create a reg directory directly inside a FEAT directory
  call_ants2featreg \\
    --t1w sub-002_T1w.nii.gz \\
    --t1w-to-mni-affine t1_to_mni_0GenericAffine.mat \\
    --t1w-to-mni-warp t1_to_mni_1Warp.nii.gz \\
    --boldref run1.feat/example_func.nii.gz \\
    --bold-to-t1w sub-002_from-bold_to-T1w_xfm.txt \\
    --feat-dir run1.feat \\
    --update-featreg

  # Use a composite fMRIPrep/ANTs .h5 transform instead of separate affine and warp files
  call_ants2featreg \\
    --t1w sub-002_T1w.nii.gz \\
    --t1w-to-mni-h5 sub-002_from-T1w_to-MNI152NLin2009cAsym_xfm.h5 \\
    --boldref run1.feat/example_func.nii.gz \\
    --bold-to-t1w sub-002_from-bold_to-T1w_xfm.txt \\
    --feat-dir run1.feat \\
    --update-featreg \\
    --clean

Notes:
  This script requires FSL, ANTs, Connectome Workbench, and c3d_affine_tool to be available in the
  shell environment. When --update-featreg is used, --feat-dir must also be provided.

---------------------------------------------------------------------------------------------------

USAGE

}

if [[ $# -eq 0 ]] ; then
  usage && exit 0
fi

# Save original command-line arguments before parsing
orig_args=("$@")

die() {
  echo "ERROR: $*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Command not found: $1"
}

need_file() {
  [[ -n "${1:-}" ]] || die "Empty file path passed to need_file"
  [[ -f "$1" ]] || die "File not found: $1"
}

anat_cache_complete() {
  local dir="$1"
  local required=(
    "${dir}/highres.nii.gz"
    "${dir}/standard.nii.gz"
    "${dir}/highres2standard.mat"
    "${dir}/highres2standard_warp.nii.gz"
    "${dir}/highres2standard.nii.gz"
  )
  local f
  for f in "${required[@]}"; do
    [[ -f "${f}" ]] || return 1
  done
  return 0
}

link_cached_file() {
  local source="$1"
  local target="$2"

  [[ -f "${source}" ]] || die "Cached registration file not found: ${source}"

  if [[ -L "${target}" ]]; then
    [[ "$(readlink "${target}")" == "${source}" ]] && return 0
    rm -f "${target}"
  elif [[ -e "${target}" ]]; then
    rm -f "${target}"
  fi

  ln -s "${source}" "${target}"
}

out_dir=""
anat_cache_dir=""
t1w=""
t1w_to_mni_affine=""
t1w_to_mni_warp=""
boldref=""
bold_to_t1w=""
template="${FSLDIR:-}/data/standard/MNI152_T1_1mm_brain.nii.gz"
feat_dir=""
update_featreg=false
apply_featreg=false
stats_subdir="stats"
clean=false
t1w_to_mni_h5=""
tmp_transform_base=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --out-dir)
      out_dir="$2"; shift 2 ;;
    --anat-cache-dir)
      anat_cache_dir="$2"; shift 2 ;;
    --t1w)
      t1w="$2"; shift 2 ;;
    --t1w-to-mni-affine)
      t1w_to_mni_affine="$2"; shift 2 ;;
    --t1w-to-mni-warp)
      t1w_to_mni_warp="$2"; shift 2 ;;
    --boldref)
      boldref="$2"; shift 2 ;;
    --bold-to-t1w)
      bold_to_t1w="$2"; shift 2 ;;
    --t1w-to-mni-h5)
      t1w_to_mni_h5="$2"; shift 2 ;;
    --template)
      template="$2"; shift 2 ;;
    --feat-dir)
      feat_dir="$2"; shift 2 ;;
    --update-featreg)
      update_featreg=true; shift ;;
    --stats-subdir)
      stats_subdir="$2"; shift 2 ;;
    --apply-featreg|--apply-reg)
      update_featreg=true; 
      apply_featreg=true; 
      shift ;;      
    --clean)
      clean=true; shift ;;
    -h|--help)
      usage; exit 0 ;;
    *)
      die "Unknown argument: $1" ;;
  esac
done

case "$stats_subdir" in
  stats|psc|both) ;;
  *) die "--stats-subdir must be stats, psc, or both" ;;
esac

if [[ -z "$out_dir" ]]; then
  if [[ -n "$feat_dir" ]]; then
    out_dir="${feat_dir}/reg"
  else
    die "--out-dir is required unless --feat-dir is provided"
  fi
fi

#-----------------------------------------------------------------------------
# Set up logging

log_file="${out_dir}/ants2feat.log"
mkdir -p "$out_dir"

# Keep original command line before redirecting output
cmdline="$(basename "$0")"
printf -v quoted_args ' %q' "$@"
cmdline="${cmdline}${quoted_args}"

# Send stdout and stderr to both terminal and log file
exec > >(tee -a "$log_file") 2>&1

print_line -
echo "call_ants2featreg"
echo "Started: $(date)"
cmdline="$(basename "$0")"

if [[ ${#orig_args[@]} -gt 0 ]]; then
    printf -v quoted_args ' %q' "${orig_args[@]}"
    cmdline="${cmdline}${quoted_args}"
fi

echo "Command: $cmdline"
echo "Host: $(hostname)"
echo "User: ${USER:-unknown}"
echo "Working directory: $(pwd)"
echo "Log file: $log_file"
print_line -

#-----------------------------------------------------------------------------
# start
[[ -n "$t1w" ]] || die "--t1w is required"

need_cmd c3d_affine_tool
need_cmd wb_command
need_cmd convertwarp
need_cmd applywarp
need_cmd ConvertTransformFile

if [[ "$apply_featreg" == true ]]; then
  need_cmd call_antsapplytransforms
  need_cmd python3
  [[ -n "$feat_dir" ]] || die "--feat-dir is required when using --apply"
fi

if [[ "$update_featreg" == true ]]; then
  need_cmd updatefeatreg
  [[ -n "$feat_dir" ]] || die "--feat-dir is required when using --update-featreg"
fi

need_file "$t1w"
need_file "$boldref"
need_file "$bold_to_t1w"
need_file "$template"

if [[ -n "$t1w_to_mni_h5" ]]; then
  need_cmd CompositeTransformUtil
  need_file "$t1w_to_mni_h5"
else
  [[ -n "$t1w_to_mni_affine" ]] || die "--t1w-to-mni-affine is required unless --t1w-to-mni-h5 is provided"
  [[ -n "$t1w_to_mni_warp" ]] || die "--t1w-to-mni-warp is required unless --t1w-to-mni-h5 is provided"

  need_file "$t1w_to_mni_affine"
  need_file "$t1w_to_mni_warp"
fi

mkdir -p "$out_dir"

# Anatomical/template products can be cached outside the contrast-specific reg
# directory. This is particularly useful for level-2 .gfeat analyses, where all
# contrasts share the same T1w->template transform but have their own functional
# reference/statistical images.
if [[ -n "${anat_cache_dir}" ]]; then
  mkdir -p "${anat_cache_dir}"
  anat_dir="${anat_cache_dir}"
  echo "Anatomical registration cache: ${anat_dir}"
else
  anat_dir="${out_dir}"
fi

echo "Creating FEAT-style reg directory: $out_dir"

if anat_cache_complete "${anat_dir}"; then
  echo "Reusing existing anatomical registration products"
else
  echo "Preparing anatomical registration products"

  [[ -f "${anat_dir}/highres.nii.gz" ]] || cp "$t1w" "${anat_dir}/highres.nii.gz"
  [[ -f "${anat_dir}/standard.nii.gz" ]] || cp "$template" "${anat_dir}/standard.nii.gz"

  if [[ -n "$t1w_to_mni_h5" ]]; then
    # Only disassemble the composite transform if an affine/warp component is
    # still required by a missing downstream cache product.
    if [[ ! -f "${anat_dir}/highres2standard.mat" ||
          ! -f "${anat_dir}/highres2standard_warp.nii.gz" ]]; then
      echo "Disassembling composite H5 transform"

      tmp_transform_base="${anat_dir}/t1w_to_mni"

      # Reuse already-disassembled components when present.
      t1w_to_mni_affine="$(
        find "${anat_dir}" -maxdepth 1 -type f \
          -name "$(basename "$tmp_transform_base")*.mat" \
          | head -n 1
      )"
      t1w_to_mni_warp="$(
        find "${anat_dir}" -maxdepth 1 -type f \
          -name "$(basename "$tmp_transform_base")*.nii.gz" \
          | head -n 1
      )"

      if [[ -z "${t1w_to_mni_affine}" || -z "${t1w_to_mni_warp}" ]]; then
        cmd=(
          CompositeTransformUtil
          --disassemble
          "$t1w_to_mni_h5"
          "$tmp_transform_base"
        )
        print_cmd "${cmd[@]}" && "${cmd[@]}"

        t1w_to_mni_affine="$(
          find "${anat_dir}" -maxdepth 1 -type f \
            -name "$(basename "$tmp_transform_base")*.mat" \
            | head -n 1
        )"
        t1w_to_mni_warp="$(
          find "${anat_dir}" -maxdepth 1 -type f \
            -name "$(basename "$tmp_transform_base")*.nii.gz" \
            | head -n 1
        )"
      fi

      [[ -n "$t1w_to_mni_affine" ]] || die "Could not extract affine .mat from $t1w_to_mni_h5"
      [[ -n "$t1w_to_mni_warp" ]] || die "Could not extract nonlinear warp .nii.gz from $t1w_to_mni_h5"
    fi
  fi

  if [[ ! -f "${anat_dir}/highres2standard.mat" ]]; then
    echo "Converting T1w-to-MNI affine to FSL format"
    cmd=(
      c3d_affine_tool
      -ref "${anat_dir}/standard.nii.gz"
      -src "${anat_dir}/highres.nii.gz"
      -itk "$t1w_to_mni_affine"
      -ras2fsl
      -o "${anat_dir}/highres2standard.mat"
    )
    print_cmd "${cmd[@]}" && "${cmd[@]}"
  else
    echo "Reusing ${anat_dir}/highres2standard.mat"
  fi

  if [[ ! -f "${anat_dir}/highres2standard_warp.nii.gz" ]]; then
    echo "Converting ANTs nonlinear warp to FNIRT/FSL format"
    tmp_warp="${anat_dir}/tmp_highres2standard_warp.nii.gz"

    cmd=(
      wb_command
      -convert-warpfield
      -from-itk "$t1w_to_mni_warp"
      -to-fnirt "$tmp_warp"
      "${anat_dir}/standard.nii.gz"
    )
    print_cmd "${cmd[@]}" && "${cmd[@]}"

    echo "Combining affine and nonlinear warp"
    cmd=(
      convertwarp
      --ref="${anat_dir}/standard.nii.gz"
      --premat="${anat_dir}/highres2standard.mat"
      --warp1="$tmp_warp"
      --out="${anat_dir}/highres2standard_warp.nii.gz"
    )
    print_cmd "${cmd[@]}" && "${cmd[@]}"
  else
    echo "Reusing ${anat_dir}/highres2standard_warp.nii.gz"
  fi

  if [[ ! -f "${anat_dir}/highres2standard.nii.gz" ]]; then
    echo "Applying highres-to-standard warp"
    cmd=(
      applywarp
      -i "${anat_dir}/highres.nii.gz"
      -r "${anat_dir}/standard.nii.gz"
      -w "${anat_dir}/highres2standard_warp.nii.gz"
      -o "${anat_dir}/highres2standard.nii.gz"
    )
    print_cmd "${cmd[@]}" && "${cmd[@]}"
  else
    echo "Reusing ${anat_dir}/highres2standard.nii.gz"
  fi
fi

# A contrast-specific FEAT reg directory must still look complete to
# updatefeatreg/FSL. Link the common anatomical products from the cache while
# leaving example_func* products local to this analysis.
if [[ "${anat_dir}" != "${out_dir}" ]]; then
  for common in \
    highres.nii.gz \
    standard.nii.gz \
    highres2standard.mat \
    highres2standard_warp.nii.gz \
    highres2standard.nii.gz
  do
    link_cached_file "${anat_dir}/${common}" "${out_dir}/${common}"
  done
fi

# Functional reference is always contrast/analysis-specific.
if [[ ! -f "${out_dir}/example_func.nii.gz" || -L "${out_dir}/example_func.nii.gz" ]]; then
  rm -f "${out_dir}/example_func.nii.gz" 2>/dev/null || true
  cp "$boldref" "${out_dir}/example_func.nii.gz"
else
  echo "Reusing ${out_dir}/example_func.nii.gz"
fi

echo "Preparing BOLD-to-T1w transform"

if [[ "$bold_to_t1w" == *.txt ]]; then
  bold_to_t1w_mat="$out_dir/example_func2highres_ants.mat"

  if [[ ! -f "${bold_to_t1w_mat}" ]]; then
    cmd=(
      ConvertTransformFile
      3
      "$bold_to_t1w"
      "$bold_to_t1w_mat"
      --convertToAffineType
    )
    print_cmd "${cmd[@]}" && "${cmd[@]}"
  else
    echo "Reusing ${bold_to_t1w_mat}"
  fi
else
  bold_to_t1w_mat="$bold_to_t1w"
fi

if [[ ! -f "$out_dir/example_func2highres.mat" ]]; then
  echo "Converting BOLD-to-T1w affine to FSL format"
  cmd=(
    c3d_affine_tool
    -ref "$out_dir/highres.nii.gz"
    -src "$out_dir/example_func.nii.gz"
    -itk "$bold_to_t1w_mat"
    -ras2fsl
    -o "$out_dir/example_func2highres.mat"
  )
  print_cmd "${cmd[@]}" && "${cmd[@]}"
else
  echo "Reusing $out_dir/example_func2highres.mat"
fi

if [[ ! -f "$out_dir/example_func2highres.nii.gz" ]]; then
  echo "Applying BOLD-to-T1w transform"
  cmd=(
    applywarp
    -i "$out_dir/example_func.nii.gz"
    -r "$out_dir/highres.nii.gz"
    --postmat="$out_dir/example_func2highres.mat"
    -o "$out_dir/example_func2highres.nii.gz"
  )
  print_cmd "${cmd[@]}" && "${cmd[@]}"
else
  echo "Reusing $out_dir/example_func2highres.nii.gz"
fi

if [[ -n "$feat_dir" ]]; then
  echo "Using FEAT directory: $feat_dir"

  [[ -d "$feat_dir" ]] || die "FEAT directory not found: $feat_dir"

  if [[ "$update_featreg" == true ]]; then
    print_line -
    echo "Running updatefeatreg"
    cmd=(updatefeatreg "$feat_dir")
    print_cmd "${cmd[@]}" && "${cmd[@]}"
  fi

  if [[ "$apply_featreg" == true ]]; then
    print_line -
    echo "Creating reg_standard-folder"

    mkdir -p "$feat_dir/reg_standard/stats" "$feat_dir/reg_standard/reg"

    if [[ -n "$t1w_to_mni_h5" ]]; then
      xfm_anat2std="$t1w_to_mni_h5"
    else
      xfm_anat2std="$t1w_to_mni_warp,$t1w_to_mni_affine"
    fi
    xfm_func2std="$xfm_anat2std,$bold_to_t1w"

    # func-space images to standard
    for img in mean_func example_func; do
      apply_one --lin \
        "$feat_dir/${img}.nii.gz" \
        "$feat_dir/reg_standard/${img}.nii.gz" \
        "$xfm_func2std"
    done

    # brain mask: nearest-neighbour / generic
    apply_one --gen \
      "$feat_dir/mask.nii.gz" \
      "$feat_dir/reg_standard/mask.nii.gz" \
      "$xfm_func2std"

    # highres to standard: T1w -> MNI only
    apply_one --lin \
      "$feat_dir/reg/highres.nii.gz" \
      "$feat_dir/reg_standard/reg/highres.nii.gz" \
      "$xfm_anat2std"

    # Geometry is shared, but native PSC normalization and validity are distinct.
    sources=("$stats_subdir")
    [[ "$stats_subdir" != "both" ]] || sources=(stats psc)
    for source_subdir in "${sources[@]}"; do
      source_dir="$feat_dir/$source_subdir"
      target_dir="$feat_dir/reg_standard/$source_subdir"
      [[ -d "$source_dir" ]] || die "Statistics directory not found: $source_dir"
      mkdir -p "$target_dir"
      rm -f "$target_dir/registration.json"
      if [[ "$source_subdir" == "psc" ]]; then
        need_file "$source_dir/normalization.json"
        need_file "$source_dir/mask.nii.gz"
        apply_one --gen "$source_dir/mask.nii.gz" "$target_dir/mask.nii.gz" "$xfm_func2std"
      fi
      found=false
      for stat in cope varcope; do
        for image in "$source_dir/${stat}"*.nii.gz; do
          [[ -e "$image" ]] || continue
          found=true
          base=$(basename "$image" .nii.gz)
          number="${base#"$stat"}"
          [[ "$number" =~ ^[0-9]+$ ]] || continue
          need_file "$source_dir/cope${number}.nii.gz"
          need_file "$source_dir/varcope${number}.nii.gz"
          apply_one --lin "$image" "$target_dir/${base}.nii.gz" "$xfm_func2std"
        done
      done
      [[ "$found" == true ]] || die "No COPE/VARCOPE pairs in $source_dir"
      if [[ "$source_subdir" == "stats" ]]; then
        for image in "$source_dir/"{tstat,zstat}*.nii.gz; do
          [[ -e "$image" ]] || continue
          apply_one --lin "$image" "$target_dir/$(basename "$image")" "$xfm_func2std"
        done
      fi
      # Publish registration provenance only after every requested image succeeds.
      python3 - "$source_dir" "$target_dir" "$template" "$xfm_func2std" <<'PYTHON'
import json
import os
from pathlib import Path
import sys
import tempfile

source, target, template = map(Path, sys.argv[1:4])
def identity(path):
    path = path.resolve()
    stat = path.stat()
    return {"path": str(path), "size": stat.st_size, "mtime_ns": stat.st_mtime_ns}

inputs = sorted(source.glob("cope[0-9]*.nii.gz")) + sorted(source.glob("varcope[0-9]*.nii.gz"))
for name in ("mask.nii.gz", "normalization.json"):
    if (source / name).is_file():
        inputs.append(source / name)
transforms = [Path(value) for value in sys.argv[4].split(",") if value]
units = "psc" if source.name == "psc" else "raw"
reference_id = ""
source_provenance = source / "normalization.json" if source.name == "psc" else source.parent / "provenance.json"
if source_provenance.is_file():
    saved = json.loads(source_provenance.read_text())
    if source.name == "psc":
        reference_id = saved["reference_id"]
    else:
        input_rows = saved.get("inputs", [])
        known_units = {row.get("effect_units", "raw") for row in input_rows}
        if len(known_units) > 1:
            raise SystemExit("Source analysis mixes statistical units")
        units = next(iter(known_units), "raw")
        references = {row.get("psc_reference_id", "") for row in input_rows}
        if units == "psc":
            if len(references) != 1 or "" in references:
                raise SystemExit("Source PSC analysis has inconsistent references")
            reference_id = references.pop()
    if source_provenance not in inputs:
        inputs.append(source_provenance)
metadata = {
    "source_subdir": source.name, "effect_units": units, "psc_reference_id": reference_id,
    "inputs": [identity(path) for path in inputs],
    "template": identity(template),
    "transforms": [identity(path) for path in transforms],
    "interpolation": {"statistics": "linear", "mask": "genericLabel"},
    "outputs": [identity(target / path.name) for path in inputs if path.suffix != ".json"],
}
fd, name = tempfile.mkstemp(prefix=".registration.", suffix=".json", dir=target)
try:
    with os.fdopen(fd, "w") as stream:
        json.dump(metadata, stream, indent=2)
        stream.write("\n")
    os.replace(name, target / "registration.json")
finally:
    if os.path.exists(name):
        os.unlink(name)
PYTHON
    done
  fi
fi

if [[ "$clean" == true ]]; then
  echo "Removing temporary files"
  [[ -n "${tmp_warp:-}" ]] && rm -f "$tmp_warp"
  rm -f "$out_dir/example_func2highres_ants.mat"

  if [[ -n "$tmp_transform_base" ]]; then
    rm -f "${tmp_transform_base}"*
  fi
fi

echo "Done."
